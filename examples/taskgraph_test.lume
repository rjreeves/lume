use taskgraph.model
use taskgraph.graph
use taskgraph.report

// A `test` block runs its whole body through the same restricted evaluator
// as a list.map/filter/find/fold callback (see README "Generic list
// transformations" and SPEC.md §12/§13): `match` anywhere in the reachable
// call graph fails at run time with "callback uses unsupported operation".
// graph.validate/order/transitive_closure all use match internally (directly
// or through helpers like graph_map_get_list), so they are exercised
// end-to-end via `lume run` instead (see the taskgraph.lume section of
// README.md for the exact commands and their expected output).
// report.to_json is match-free (json.encode is a builtin, not Lume-level
// match) and so is testable directly, below.

fn task_stub(name: str) -> Task {
  return Task(name: name, command: "cmd", args: [], depends_on: [])
}

test "contains_name finds an existing entry and rejects a missing one" {
  let names = ["install", "build", "test"]
  expect.true(contains_name(names, "build"))
  expect.true(contains_name(names, "missing") == false)
}

test "first_unresolved_name reports the first task missing from resolved" {
  let tasks = [task_stub("install"), task_stub("build"), task_stub("test")]
  let resolved = ["install", "test"]
  expect.equal(first_unresolved_name(tasks, resolved), "build")
}

test "first_unresolved_name reports nothing once every task resolved" {
  let tasks = [task_stub("install"), task_stub("build")]
  let resolved = ["install", "build"]
  expect.equal(first_unresolved_name(tasks, resolved), "")
}

test "join_names joins with a comma and space" {
  expect.equal(join_names(["a", "b", "c"]), "a, b, c")
  expect.equal(join_names(["solo"]), "solo")
  expect.equal(join_names([]), "")
}

test "to_json encodes a run's payload-carrying outcome enum" {
  let runs = [TaskRun(name: "build", outcome: Outcome.failed(exit_code: 1, message: "boom"))]
  let encoded = report.to_json(runs)
  expect.ok(encoded)
  expect.equal(result.value(encoded), "[{\"name\":\"build\",\"outcome\":{\"variant\":\"failed\",\"exit_code\":1,\"message\":\"boom\"}}]")
}

fn main(args: [str]) -> int {
  return 0
}
