use taskgraph.model
use taskgraph.graph
use taskgraph.runner
use taskgraph.report

fn usage() -> str {
  return "usage: taskgraph <manifest.json> [target] [--dry-run]"
}

fn main(args: [str]) -> int {
  if args.count() < 1 {
    eprint(usage())
    return 64
  }

  let manifest_path = args.get(0)

  var target = ""
  var dry_run = false
  if args.count() >= 2 {
    let second = args.get(1)
    if second == "--dry-run" {
      dry_run = true
    } else {
      target = second
    }
  }
  if args.count() >= 3 {
    let third = args.get(2)
    if third == "--dry-run" {
      dry_run = true
    }
  }

  let read = fs.try_read_text(manifest_path)
  if result.is_ok(read) == false {
    eprint(result.error(read))
    return 1
  }

  let parsed = model.parse(result.value(read))
  if result.is_ok(parsed) == false {
    eprint(result.error(parsed))
    return 1
  }
  let manifest = result.value(parsed)

  let validated = graph.validate(manifest.tasks)
  if graph.is_valid(validated) == false {
    eprint(graph.error_of(validated))
    return 1
  }
  let all_tasks = graph.unwrap(validated)

  var selected = all_tasks
  if target != "" {
    let scoped = graph.transitive_closure(all_tasks, target)
    if graph.is_valid(scoped) == false {
      eprint(graph.error_of(scoped))
      return 1
    }
    selected = graph.unwrap(scoped)
  }

  let ordered_result = graph.order(selected)
  if graph.is_valid(ordered_result) == false {
    eprint(graph.error_of(ordered_result))
    return 1
  }
  let ordered = graph.unwrap(ordered_result)

  if dry_run {
    print("planned order:")
    print(report.render_plan(ordered))
    return 0
  }

  let runs = runner.run_all(ordered)
  print(report.render_summary(runs))
  print("passed:")
  print(report.count_passed(runs))
  print("failed:")
  print(report.count_failed(runs))
  print("skipped:")
  print(report.count_skipped(runs))

  let json_result = report.to_json(runs)
  if result.is_ok(json_result) {
    let report_path = path.join(path.dirname(manifest_path), "taskgraph-report.json")
    let written = fs.try_write_text(report_path, result.value(json_result))
    if result.is_ok(written) {
      print("report written to " + report_path)
    }
  }

  if report.count_failed(runs) > 0 {
    return 1
  }
  return 0
}
