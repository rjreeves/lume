{
  "tasks": [
    {
      "name": "install",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-Command", "Write-Output installing"],
      "depends_on": []
    },
    {
      "name": "build",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-Command", "Write-Error 'build broke'; exit 1"],
      "depends_on": ["install"]
    },
    {
      "name": "test",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-Command", "Write-Output testing"],
      "depends_on": ["build"]
    },
    {
      "name": "release",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-Command", "Write-Output releasing"],
      "depends_on": ["test"]
    }
  ]
}
