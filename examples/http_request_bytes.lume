fn main(args: [str]) -> int {
  let headers = map.set(map.new(), "X-Lume-Bytes-Test", "1")
  let body = bytes.from_str("hello-bytes-payload")
  let outcome = http.request_bytes("POST", "https://httpbin.org/post", headers, body)
  if result.is_ok(outcome) {
    let response = result.value(outcome)
    print(http.ok(response))
    print(str.contains(http.body(response), "hello-bytes-payload"))
    let bodyBytes = http.body_bytes(response)
    print(bytes.length(bodyBytes) > 0)
    print(str.contains(bytes.to_str(bodyBytes), "hello-bytes-payload"))
  } else {
    print(result.error(outcome))
  }
  return 0
}
