fn double(n: int) -> int { return n * 2 }

fn main(args: [str]) -> int {
  let x = if true { 1 } else { 2 }
  print(x)
  let y = if false { 1 } else { 2 }
  print(y)
  print(if 3 > 2 { "big" } else { "small" })
  print((if true { 10 } else { 20 }) + 5)
  let z = if false { 1 } else { double(21) }
  print(z)
  return 0
}
