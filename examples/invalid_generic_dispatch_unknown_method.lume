protocol Named {
  fn name(value: Self) -> str
}

type User {
  name: str
}

impl Named for User {
  fn name(value: User) -> str {
    return value.name
  }
}

fn keep_named<T: Named>(value: T) -> T {
  print(T.missing(value))
  return value
}

fn main(args: [str]) -> int {
  let user = keep_named(User(name: "Ada"))
  return 0
}
