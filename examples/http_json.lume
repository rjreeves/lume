type Slideshow {
  author: str
  title: str
}

type SlideshowResponse {
  slideshow: Slideshow
}

fn main(args: [str]) -> int {
  let outcome = http.get("https://httpbin.org/json")
  if result.is_ok(outcome) == false {
    eprint(result.error(outcome))
    return 1
  }
  let response = result.value(outcome)

  let decoded = SlideshowResponse.from_json(http.body(response))
  if result.is_ok(decoded) == false {
    eprint(result.error(decoded))
    return 1
  }
  let show = result.value(decoded)
  print(show.slideshow.author)
  print(show.slideshow.title)
  return 0
}
