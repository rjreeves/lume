// True word-splitting isn't possible yet - str.* has no split, substring,
// or character-index operation (see BACKLOG.md) - so this reports a file's
// character count instead, the closest metric actually computable today.
fn main(args: [str]) -> int {
  var path = ""
  if args.count() > 0 {
    path = args.get(0)
  }
  if path == "" {
    eprint("usage: word_count <file>")
    return 64
  }

  if fs.exists(path) == false {
    eprint("file not found: " + path)
    return 1
  }

  let text = fs.read_text(path)
  print(str.len(text))
  return 0
}
