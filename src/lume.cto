      } else if let Err(message) = requireText(pattern.value, name) { problem = message }
    } else if let Err(message) = requireInt(seconds.value, name) { problem = message }
  } else if Text.eq(name, "duration.seconds") or Text.eq(name, "duration.minutes") or Text.eq(name, "duration.hours") or Text.eq(name, "duration.days") then {
    val one = pop(stack)
    stack = one.stack
    if let Ok(value) = requireInt(one.value, name) {
      if Text.eq(name, "duration.seconds") then { result = intValue(value) }
      else if Text.eq(name, "duration.minutes") then { result = intValue(value * 60) }
      else if Text.eq(name, "duration.hours") then { result = intValue(value * 3600) }
      else { result = intValue(value * 86400) }
    } else if let Err(message) = requireInt(one.value, name) { problem = message }
  } else if Text.eq(name, "Duration.of_seconds") or Text.eq(name, "Duration.of_minutes") or Text.eq(name, "Duration.of_hours") or Text.eq(name, "Duration.of_days") then {
    val one = pop(stack)
    stack = one.stack
    if let Ok(value) = requireInt(one.value, name) {
      if Text.eq(name, "Duration.of_seconds") then { result = buildDurationValue(value) }
      else if Text.eq(name, "Duration.of_minutes") then { result = buildDurationValue(value * 60) }
      else if Text.eq(name, "Duration.of_hours") then { result = buildDurationValue(value * 3600) }
      else { result = buildDurationValue(value * 86400) }
    } else if let Err(message) = requireInt(one.value, name) { problem = message }
  } else if Text.eq(name, "Duration.add") or Text.eq(name, "Duration.sub") then {
    val b = pop(stack)
    val a = pop(b.stack)
    stack = a.stack
    val aSeconds = lumeDurationSeconds(a.value)
    val bSeconds = lumeDurationSeconds(b.value)
    result = buildDurationValue(if Text.eq(name, "Duration.add") then aSeconds + bSeconds else aSeconds - bSeconds)
  } else if Text.eq(name, "Duration.scale") then {
    val factor = pop(stack)
    val duration = pop(factor.stack)
    stack = duration.stack
    if let Ok(factorValue) = requireInt(factor.value, name) { result = buildDurationValue(lumeDurationSeconds(duration.value) * factorValue) }
    else if let Err(message) = requireInt(factor.value, name) { problem = message }
  } else if Text.eq(name, "Duration.to_seconds") then {
    val duration = pop(stack)
    stack = duration.stack
    result = intValue(lumeDurationSeconds(duration.value))
  } else if Text.eq(name, "time.year") or Text.eq(name, "time.month") or Text.eq(name, "time.day") or Text.eq(name, "time.hour") or Text.eq(name, "time.minute") or Text.eq(name, "time.second") then {
    val one = pop(stack)
    stack = one.stack
    if let Ok(value) = requireInt(one.value, name) {
      val dt = DateTime.fromUnix(value)
      if Text.eq(name, "time.year") then { result = intValue(DateTime.year(dt)) }
      else if Text.eq(name, "time.month") then { result = intValue(DateTime.month(dt)) }
      else if Text.eq(name, "time.day") then { result = intValue(DateTime.day(dt)) }
      else if Text.eq(name, "time.hour") then { result = intValue(DateTime.hour(dt)) }
      else if Text.eq(name, "time.minute") then { result = intValue(DateTime.minute(dt)) }
      else { result = intValue(DateTime.second(dt)) }
    } else if let Err(message) = requireInt(one.value, name) { problem = message }
  } else if Text.eq(name, "http.get") or Text.eq(name, "http.delete") then {
    val one = pop(stack)
    stack = one.stack
    if let Ok(url) = requireText(one.value, name) {
      val method = if Text.eq(name, "http.get") then "GET" else "DELETE"
      val response = Http.requestWithLimit(method, url, [], "", 10485760)
      val status = HttpResponse.status(response)
      if status == 0 then { result = resultErr(name ++ " failed to reach `" ++ url ++ "`") }
      else if HttpResponse.truncated(response) then { result = resultErr(name ++ " response exceeds the 10 MiB limit") }
      else { result = resultOk(httpValue(response)) }
    } else if let Err(message) = requireText(one.value, name) { problem = message }
  } else if Text.eq(name, "http.post") or Text.eq(name, "http.put") then {
    val contentType = pop(stack)
    val body = pop(contentType.stack)
    val url = pop(body.stack)
    stack = url.stack
    if let Ok(urlText) = requireText(url.value, name) {
      if let Ok(bodyText) = requireText(body.value, name) {
        if let Ok(contentTypeText) = requireText(contentType.value, name) {
          val method = if Text.eq(name, "http.post") then "POST" else "PUT"
          val response = Http.requestWithLimit(method, urlText, [["Content-Type", contentTypeText]], bodyText, 10485760)
          val status = HttpResponse.status(response)
          if status == 0 then { result = resultErr(name ++ " failed to reach `" ++ urlText ++ "`") }
          else if HttpResponse.truncated(response) then { result = resultErr(name ++ " response exceeds the 10 MiB limit") }
          else { result = resultOk(httpValue(response)) }
        } else if let Err(message) = requireText(contentType.value, name) { problem = message }
      } else if let Err(message) = requireText(body.value, name) { problem = message }
    } else if let Err(message) = requireText(url.value, name) { problem = message }
  } else if Text.eq(name, "http.request") then {
    val bodyArg = pop(stack)
    val headersArg = pop(bodyArg.stack)
    val urlArg = pop(headersArg.stack)
    val methodArg = pop(urlArg.stack)
    stack = methodArg.stack
    if let Ok(methodText) = requireText(methodArg.value, name) {
      if let Ok(urlText) = requireText(urlArg.value, name) {
        if let Ok(bodyText) = requireText(bodyArg.value, name) {
          var headers: List<List<Text>> = []
          for taggedKey in mapKeysList(headersArg.value) {
            if let Some(taggedValue) = mapGetValue(headersArg.value, taggedKey) {
              headers = List.push(headers, [valueBody(taggedKey), valueBody(taggedValue)])
            }
          }
          val response = Http.requestWithLimit(methodText, urlText, headers, bodyText, 10485760)
          val status = HttpResponse.status(response)
          if status == 0 then { result = resultErr(name ++ " failed to reach `" ++ urlText ++ "`") }
          else if HttpResponse.truncated(response) then { result = resultErr(name ++ " response exceeds the 10 MiB limit") }
          else { result = resultOk(httpValue(response)) }
        } else if let Err(message) = requireText(bodyArg.value, name) { problem = message }
      } else if let Err(message) = requireText(urlArg.value, name) { problem = message }
    } else if let Err(message) = requireText(methodArg.value, name) { problem = message }
  } else if Text.eq(name, "http.request_with_limit") then {
    val maxBytesArg = pop(stack)
    val bodyArg = pop(maxBytesArg.stack)
    val headersArg = pop(bodyArg.stack)
    val urlArg = pop(headersArg.stack)
    val methodArg = pop(urlArg.stack)
    stack = methodArg.stack
    if let Ok(methodText) = requireText(methodArg.value, name) {
      if let Ok(urlText) = requireText(urlArg.value, name) {
        if let Ok(bodyText) = requireText(bodyArg.value, name) {
          if not Text.eq(valueKind(maxBytesArg.value), "i:") then { problem = "E0729 http.request_with_limit requires (str, str, Map<str,str>, str, int)" }
          else {
            var headers: List<List<Text>> = []
            for taggedKey in mapKeysList(headersArg.value) {
              if let Some(taggedValue) = mapGetValue(headersArg.value, taggedKey) {
                headers = List.push(headers, [valueBody(taggedKey), valueBody(taggedValue)])
              }
            }
            val response = Http.requestWithLimit(methodText, urlText, headers, bodyText, valueInt(maxBytesArg.value))
            val status = HttpResponse.status(response)
            if status == 0 then { result = resultErr(name ++ " failed to reach `" ++ urlText ++ "`") }
            else { result = resultOk(httpValue(response)) }
          }
        } else if let Err(message) = requireText(bodyArg.value, name) { problem = message }
      } else if let Err(message) = requireText(urlArg.value, name) { problem = message }
    } else if let Err(message) = requireText(methodArg.value, name) { problem = message }
  } else if Text.eq(name, "http.request_bytes") then {
    val bodyArg = pop(stack)
    val headersArg = pop(bodyArg.stack)
    val urlArg = pop(headersArg.stack)
    val methodArg = pop(urlArg.stack)
    stack = methodArg.stack
    if let Ok(methodText) = requireText(methodArg.value, name) {
      if let Ok(urlText) = requireText(urlArg.value, name) {
        if not Text.eq(valueKind(bodyArg.value), "y:") then { problem = "E0714 http.request_bytes requires (str, str, Map<str,str>, bytes)" }
        else {
          var headers: List<List<Text>> = []
          for taggedKey in mapKeysList(headersArg.value) {
            if let Some(taggedValue) = mapGetValue(headersArg.value, taggedKey) {
              headers = List.push(headers, [valueBody(taggedKey), valueBody(taggedValue)])
            }
          }
          val response = Http.requestBytes(methodText, urlText, headers, Bytes.fromText(valueBody(bodyArg.value)))
          val status = HttpResponse.status(response)
          if status == 0 then { result = resultErr(name ++ " failed to reach `" ++ urlText ++ "`") }
          else if HttpResponse.bodyLength(response) > 10485760 then { result = resultErr(name ++ " response exceeds the 10 MiB limit") }
          else { result = resultOk(httpValue(response)) }
        }
      } else if let Err(message) = requireText(urlArg.value, name) { problem = message }
    } else if let Err(message) = requireText(methodArg.value, name) { problem = message }
  } else if Text.eq(name, "bytes.to_str") or Text.eq(name, "bytes.length") then {
    val one = pop(stack)
    stack = one.stack
    if not Text.eq(valueKind(one.value), "y:") then { problem = "E0712 builtin `" ++ name ++ "` requires bytes" }
    else if Text.eq(name, "bytes.length") then { result = intValue(Text.len(valueBody(one.value))) }
    else { result = textValue(valueBody(one.value)) }
  } else if Text.eq(name, "fs.write_bytes") then {
    val dataArg = pop(stack)
    val pathArg = pop(dataArg.stack)
    stack = pathArg.stack
    if let Ok(path) = requireText(pathArg.value, name) {
      if not Text.eq(valueKind(dataArg.value), "y:") then { problem = "E0713 fs.write_bytes requires (str, bytes)" }
      else { result = boolValue(writeFileBytes(path, Bytes.fromText(valueBody(dataArg.value)))) }
    } else if let Err(message) = requireText(pathArg.value, name) { problem = message }
  } else if Text.eq(name, "http.status") or Text.eq(name, "http.body") or Text.eq(name, "http.content_type") or Text.eq(name, "http.ok") or Text.eq(name, "http.body_bytes") or Text.eq(name, "http.truncated") then {
    val one = pop(stack)
    stack = one.stack
    if not Text.eq(valueKind(one.value), "h:") then { problem = "E0704 http accessor requires http result" }
    else if Text.eq(name, "http.status") then { result = httpField(one.value, "status") }
    else if Text.eq(name, "http.body") then { result = httpField(one.value, "body") }
    else if Text.eq(name, "http.content_type") then { result = httpField(one.value, "content_type") }
    else if Text.eq(name, "http.body_bytes") then { result = bytesValue(valueBody(httpField(one.value, "body"))) }
    else if Text.eq(name, "http.truncated") then { result = httpField(one.value, "truncated") }
    else { result = httpField(one.value, "ok") }
  } else {
    val right = pop(stack)
    val left = pop(right.stack)
    stack = left.stack
    if let Ok(first) = requireText(left.value, name) {
      if let Ok(second) = requireText(right.value, name) {
        if Text.eq(name, "fs.write_text") then {
          result = boolValue(writeFile(first, second))
        } else if Text.eq(name, "fs.try_write_text") then {
          if writeFile(first, second) then { result = resultOk(boolValue(true)) }
          else { result = resultErr("cannot write file `" ++ first ++ "`") }
        } else if Text.eq(name, "str.contains") then { result = boolValue(Text.contains(first, second)) }
        else if Text.eq(name, "str.starts_with") then { result = boolValue(Text.startsWith(first, second)) }
        else if Text.eq(name, "str.ends_with") then { result = boolValue(Text.endsWith(first, second)) }
        else if Text.eq(name, "json.get") then {
          val parsed = Json.parse(first)
          if not JsonValue.isObject(parsed) then { problem = "E0313 json.get expected an object" }
          else { result = textValue(jsonScalar(JsonValue.get(parsed, second))) }
        } else if Text.eq(name, "path.join") then { result = textValue(Path.join(first, second)) }
        else if Text.eq(name, "env.set") then {
          setEnv(first, second)
          result = boolValue(true)
        }
        else { problem = "E0314 unknown builtin `" ++ name ++ "`" }
      } else if let Err(message) = requireText(right.value, name) { problem = message }
    } else if let Err(message) = requireText(left.value, name) { problem = message }
  }
  if Text.eq(problem, "") then { BuiltinResult { stack: List.push(stack, result), problem: "" } }
  else {
    val spaceIndex = Text.indexOf(problem, " ") ?? Text.len(problem)
    val formatted = Text.slice(problem, 0, spaceIndex) ++ " line " ++ intToText(line) ++ ": " ++ Text.slice(problem, spaceIndex + 1, Text.len(problem))
    builtinFailure(stack, formatted)
  }
}

fn execute(code: List<Instruction>): RunResult [io] = {
  var stack: List<Text> = []
  var variables = Bindings { names: [], values: [] }
  var returnAddresses: List<Int> = []
  var matchVariableNames: List<List<Text>> = []
  var matchVariableValues: List<List<Text>> = []
  var depth = 0
  var ip = findFunction(code, "main") + 1
  var exitCode = 0
  var running = true
  var problem = ""
  while ip < List.len(code) and running and Text.eq(problem, "") {
    val current = List.getOrPanic(code, ip)
    var advance = true
    if Text.eq(current.op, "const_int") then { stack = List.push(stack, intValue(current.number)) }
    else if Text.eq(current.op, "const_str") then { stack = List.push(stack, textValue(current.text)) }
    else if Text.eq(current.op, "const_bool") then { stack = List.push(stack, boolValue(current.number == 1)) }
    else if Text.eq(current.op, "fn_ref") then { stack = List.push(stack, "f:" ++ current.text) }
    else if Text.eq(current.op, "closure_start") then {
      stack = List.push(stack, closureValue(ip + 1, variables, intToText(depth) ++ ":"))
      ip = ip + current.number
      advance = false
    }
    else if Text.eq(current.op, "make_list") then {
      val built = buildList(stack, current.number)
      stack = List.push(built.stack, built.value)
    } else if Text.eq(current.op, "make_record") then {
      val built = buildRecord(stack, current.text, current.number)
      stack = List.push(built.stack, built.value)
    } else if Text.eq(current.op, "update_record") then {
      val built = updateRecord(stack, current.text, current.number)
      stack = List.push(built.stack, built.value)
    } else if Text.eq(current.op, "make_variant") then {
      val built = buildVariant(stack, current.text, current.number)
      stack = List.push(built.stack, built.value)
    } else if Text.eq(current.op, "main_param") then {
      variables = putBinding(variables, scopedName(depth, beforePipe(current.text)), commandArgsValue())
    }
    else if Text.eq(current.op, "load") then {
      if let Some(value) = getBinding(variables, scopedName(depth, current.text)) { stack = List.push(stack, value) }
      else { problem = "E0303 line " ++ intToText(current.line) ++ ": undefined binding `" ++ current.text ++ "`" }
    } else if Text.eq(current.op, "get_field") then {
      val item = pop(stack)
      stack = item.stack
      if let Some(value) = recordField(item.value, current.text) { stack = List.push(stack, value) }
      else { problem = "E0330 line " ++ intToText(current.line) ++ ": record field `" ++ current.text ++ "` is unavailable" }
    } else if Text.eq(current.op, "decode_json") then {
      val item = pop(stack)
      stack = item.stack
      if Text.eq(valueKind(item.value), "s:") then { stack = List.push(stack, decodeRecordJson(code, current.text, valueBody(item.value))) }
      else { problem = "E0331 line " ++ intToText(current.line) ++ ": JSON decoder requires str" }
    } else if Text.eq(current.op, "match_start") then {
      matchVariableNames = List.push(matchVariableNames, variables.names)
      matchVariableValues = List.push(matchVariableValues, variables.values)
    } else if Text.eq(current.op, "match_arm") then {
      val subject = List.getOrPanic(stack, List.len(stack) - 1)
      val constructor = beforePipe(current.text)
      val expected = if Text.contains(constructor, ".") then afterDot(constructor) else constructor
      if Text.eq(runtimeVariantName(subject), expected) then {
        variables = bindVariantPayload(code, variables, depth, subject, current.text)
        val consumed = pop(stack)
        stack = consumed.stack
      } else {
        ip = ip + current.number
        advance = false
      }
    } else if Text.eq(current.op, "match_arm_end") then {
      ip = ip + current.number
      advance = false
    } else if Text.eq(current.op, "match_finish") then {
      variables = Bindings {
        names: List.getOrPanic(matchVariableNames, List.len(matchVariableNames) - 1),
        values: List.getOrPanic(matchVariableValues, List.len(matchVariableValues) - 1)
      }
      matchVariableNames = List.slice(matchVariableNames, 0, List.len(matchVariableNames) - 1)
      matchVariableValues = List.slice(matchVariableValues, 0, List.len(matchVariableValues) - 1)
    } else if Text.eq(current.op, "store") then {
      val item = pop(stack)
      stack = item.stack
      variables = putBinding(variables, scopedName(depth, beforePipe(current.text)), item.value)
    } else if Text.eq(current.op, "param") then {
      val item = pop(stack)
      stack = item.stack
      variables = putBinding(variables, scopedName(depth, beforePipe(current.text)), item.value)
    } else if Text.eq(current.op, "call") then {
      val target = findFunction(code, current.text)
      if target < 0 then {
        val builtin = callBuiltin(code, current.text, stack, 0, 0, current.line)
        stack = builtin.stack
        problem = builtin.problem
      }
      else {
        returnAddresses = List.push(returnAddresses, ip + 1)
        depth = depth + 1
        ip = target + 1
        advance = false
      }
    } else if Text.eq(current.op, "generic_call") then {
      // execute()'s own "call" branch above never pops arguments itself -
      // it jumps and lets the callee's own "param" instructions pop them
      // from this same shared stack in due course. This mirrors that: peek
      // the receiver (same pattern match_arm uses to inspect a value's
      // runtime tag without consuming it) and, once resolved, jump exactly
      // like an ordinary successful call - the callee's own "param"
      // instructions will still find all arguments sitting exactly where the
      // call site left them, since this branch never touches the stack.
      // current.number is packed by patchGenericDispatch as
      // argCount*1000+selfIndex; the receiver sits selfIndex slots up from
      // the bottom of the argCount-sized argument window at the top of stack.
      val methodName = afterDot(current.text)
      val argCount = current.number / 1000
      val selfIndex = current.number % 1000
      val receiver = List.getOrPanic(stack, List.len(stack) - argCount + selfIndex)
      val concreteName = runtimeTypeName(receiver) ++ "." ++ methodName
      val target = findFunction(code, concreteName)
      if target < 0 then {
        problem = "E0693 line " ++ intToText(current.line) ++ ": no implementation of `" ++ methodName ++ "` for `" ++ runtimeTypeName(receiver) ++ "`"
      } else {
        returnAddresses = List.push(returnAddresses, ip + 1)
        depth = depth + 1
        ip = target + 1
        advance = false
      }
    } else if Text.eq(current.op, "unwrap") or Text.eq(current.op, "propagate") then {
      val wrapped = pop(stack)
      stack = wrapped.stack
      if not isResultValue(wrapped.value) then { problem = "E0324 result propagation requires a result value" }
      else if lumeResultIsOk(wrapped.value) then { stack = List.push(stack, resultInner(wrapped.value)) }
      else if List.len(returnAddresses) > 0 then {
        val address = popInt(returnAddresses)
        returnAddresses = address.stack
        depth = depth - 1
        stack = List.push(stack, wrapped.value)
        ip = address.value
        advance = false
      } else {
        // No caller left to propagate to (a `?`/`!` failing directly
        // inside main, with no enclosing result-returning function) -
        // resultInner returns the error payload's own ordinarily-tagged
        // value (e.g. "s:message"), so strip that tag for the plain
        // diagnostic text this becomes.
        problem = valueBody(resultInner(wrapped.value))
      }
    } else if Text.eq(current.op, "neg") then {
      val item = pop(stack)
      stack = List.push(item.stack, intValue(0 - valueInt(item.value)))
    } else if Text.eq(current.op, "add") or Text.eq(current.op, "sub") or Text.eq(current.op, "mul") or Text.eq(current.op, "div") or Text.eq(current.op, "mod") then {
      val right = pop(stack)
      val left = pop(right.stack)
      val outcome = binary(current.op, left.value, right.value, current.line)
      if let Ok(value) = outcome { stack = List.push(left.stack, value) }
      else if let Err(message) = outcome { problem = message }
    } else if Text.eq(current.op, "compare") then {
      val right = pop(stack)
      val left = pop(right.stack)
      if let Ok(value) = dispatchCompare(code, current.text, left.value, right.value, current.line, 0, 0) { stack = List.push(left.stack, value) }
      else if let Err(message) = dispatchCompare(code, current.text, left.value, right.value, current.line, 0, 0) { problem = message }
    } else if Text.eq(current.op, "jump_false") then {
      val item = pop(stack)
      stack = item.stack
      if not Text.eq(valueKind(item.value), "b:") then {
        problem = "E0305 line " ++ intToText(current.line) ++ ": condition must be bool"
      } else if Text.eq(valueBody(item.value), "false") then {
        ip = ip + current.number
        advance = false
      }
    } else if Text.eq(current.op, "jump") then {
      ip = ip + current.number
      advance = false
    } else if Text.eq(current.op, "if_expr_start") then {
      val item = pop(stack)
      stack = item.stack
      if not Text.eq(valueKind(item.value), "b:") then {
        problem = "E0305 line " ++ intToText(current.line) ++ ": condition must be bool"
      } else if Text.eq(valueBody(item.value), "false") then {
        ip = ip + current.number
        advance = false
      }
    } else if Text.eq(current.op, "if_expr_then_end") then {
      ip = ip + current.number
      advance = false
    } else if Text.eq(current.op, "if_expr_finish") then {
      // no-op: whichever branch ran already left exactly one result value
      // on the stack; both real execution paths converge here.
    } else if Text.eq(current.op, "print") or Text.eq(current.op, "eprint") then {
      val item = pop(stack)
      stack = item.stack
      if Text.eq(current.op, "print") then { println(display(item.value)) } else { eprintln(display(item.value)) }
    } else if Text.eq(current.op, "test_expect") then {
      val item = pop(stack)
      stack = item.stack
      if Text.eq(valueKind(item.value), "x:") then { problem = valueBody(item.value) }
      else if not Text.eq(item.value, boolValue(true)) then { problem = "expectation returned false" }
    } else if Text.eq(current.op, "return") then {
      val item = pop(stack)
      stack = item.stack
      if List.len(returnAddresses) > 0 then {
        val address = popInt(returnAddresses)
        returnAddresses = address.stack
        depth = depth - 1
        stack = List.push(stack, item.value)
        ip = address.value
        advance = false
      } else if not Text.eq(valueKind(item.value), "i:") then { problem = "E0304 main must return int" }
      else {
        exitCode = valueInt(item.value)
        running = false
      }
    } else { problem = "E0725 line " ++ intToText(current.line) ++ ": unknown bytecode operation `" ++ current.op ++ "`" }
    if advance then { ip = ip + 1 }
  }
  RunResult { code: exitCode, problem: problem }
}

fn appendBinaryText(parts: List<Bytes>, value: Text): List<Bytes> = {
  var output = List.pushMut(parts, Bytes.fromInt64LE(Text.byteLength(value)))
  List.pushMut(output, Bytes.fromText(value))
}

// Replaced by build.ps1 with a real sha256 of this file's own source,
// before invoking Certo - see build.ps1's own templating step. Running
// `certo run src/lume.cto` directly (bypassing build.ps1) leaves this
// literal placeholder in place, which is harmless: every .lbc produced by
// that one build still gets a consistent identity, correctly rejecting
// caches from any *real* build either way. Deliberately exactly 64
// characters, matching a real sha256 hex digest's own length exactly -
// encodeArtifact/decodeArtifact both treat this as a fixed-size field the
// same way they already do the source hash, so an un-substituted
// placeholder of the wrong length would corrupt every byte offset after it.
fn compilerBuildHash(): Text = "UNBUILT_UNBUILT_UNBUILT_UNBUILT_UNBUILT_UNBUILT_UNBUILT_UNBUILT_"

fn encodeArtifact(source: Text, code: List<Instruction>): Bytes = {
  var parts: List<Bytes> = []
  parts = List.pushMut(parts, Bytes.fromText("LBC5"))
  parts = List.pushMut(parts, Bytes.fromText(Crypto.sha256(source)))
  parts = List.pushMut(parts, Bytes.fromText(compilerBuildHash()))
  parts = List.pushMut(parts, Bytes.fromInt64LE(List.len(code)))
  for instructionItem in code {
    parts = appendBinaryText(parts, instructionItem.op)
    parts = appendBinaryText(parts, instructionItem.text)
    parts = List.pushMut(parts, Bytes.fromInt64LE(instructionItem.number))
    parts = List.pushMut(parts, Bytes.fromInt64LE(instructionItem.line))
  }
  Bytes.concatMany(parts)
}

// Header layout: "LBC5" (4) + source sha256 hex (64) + compiler build
// hash hex (64) + instruction count (8) = 140 bytes before the first
// instruction - bumped from LBC4's 76-byte header (no build hash field)
// when this file gained the ability to tell "same source, different
// compiler build" apart from a genuine cache hit; see compileOrCache.
//
// Split out from decodeArtifact so a caller that only needs to check
// whether a cache hit is even possible (compileOrCache) never pays the
// cost of decoding the instruction body below - confirmed live
// (BENCHMARKS.md's "one-function incremental rebuild" checkpoint) that
// a stale cache used to cost *more* to detect and discard than a
// genuinely cold build with no cache file at all, since the full
// instruction list was always decoded before anyone checked the hash.
fn decodeArtifactHeader(content: Bytes): ArtifactHeader = {
  val contentLength = Bytes.length(content)
  if contentLength < 140 then { ArtifactHeader { sourceHash: "", buildHash: "", problem: "E0401 invalid bytecode artifact" } }
  else if not Text.eq(Bytes.toText(Bytes.slice(content, 0, 4)), "LBC5") then {
    ArtifactHeader { sourceHash: "", buildHash: "", problem: "E0402 unsupported bytecode format" }
  } else {
    ArtifactHeader {
      sourceHash: Bytes.toText(Bytes.slice(content, 4, 68)),
      buildHash: Bytes.toText(Bytes.slice(content, 68, 132)),
      problem: ""
    }
  }
}

fn decodeArtifact(content: Bytes): ArtifactResult = {
  val header = decodeArtifactHeader(content)
  if not Text.eq(header.problem, "") then {
    ArtifactResult { code: [], sourceHash: "", buildHash: "", problem: header.problem }
  } else {
    var code: List<Instruction> = []
    var problem = ""
    val contentLength = Bytes.length(content)
    val instructionCount = Bytes.readInt64LE(content, 132)
    var cursor = 140
    var index = 0
    if instructionCount < 0 or instructionCount > contentLength then { problem = "E0403 invalid bytecode instruction count" }
    while index < instructionCount and Text.eq(problem, "") {
      var op = ""
      var text = ""
      if cursor + 8 > contentLength then { problem = "E0403 truncated bytecode instruction" }
      else {
        val opLength = Bytes.readInt64LE(content, cursor)
        cursor = cursor + 8
        if opLength < 0 or cursor + opLength > contentLength then { problem = "E0403 invalid bytecode opcode" }
        else {
          op = Bytes.toText(Bytes.slice(content, cursor, cursor + opLength))
          cursor = cursor + opLength
        }
      }
      if Text.eq(problem, "") then {
        if cursor + 8 > contentLength then { problem = "E0403 truncated bytecode instruction" }
        else {
          val textLength = Bytes.readInt64LE(content, cursor)
          cursor = cursor + 8
          if textLength < 0 or cursor + textLength > contentLength then { problem = "E0403 invalid bytecode operand" }
          else {
            text = Bytes.toText(Bytes.slice(content, cursor, cursor + textLength))
            cursor = cursor + textLength
          }
        }
      }
      if Text.eq(problem, "") then {
        if cursor + 16 > contentLength then { problem = "E0403 truncated bytecode instruction" }
        else {
          code = List.pushMut(code, makeInstruction(
            op,
            text,
            Bytes.readInt64LE(content, cursor),
            Bytes.readInt64LE(content, cursor + 8)
          ))
          cursor = cursor + 16
        }
      }
      index = index + 1
    }
    if Text.eq(problem, "") and cursor != contentLength then { problem = "E0403 trailing bytecode data" }
    ArtifactResult { code: code, sourceHash: header.sourceHash, buildHash: header.buildHash, problem: problem }
  }
}

fn saveArtifact(path: Text, source: Text, code: List<Instruction>): Text [io] = {
  if writeFileBytes(path, encodeArtifact(source, code)) then ""
  else "E0404 cannot write bytecode artifact `" ++ path ++ "`"
}

// Unlike decodeArtifact's own caller compileOrCache - which treats a
// build-hash mismatch as an ordinary cache miss and transparently
// recompiles from the source it already has - exec has no source to
// fall back to at all - the artifact IS the program. Running one built
// by a meaningfully different compiler (a fixed runtime bug, a changed
// opcode's semantics) would otherwise execute silently and incorrectly
// instead of being rejected, the exact gap BACKLOG.md item 5 confirmed
// live (a hand-corrupted buildHash byte range still ran without error).
// So this, not decodeArtifact, is where the check belongs: it is the
// one function whose whole purpose is loading a `.lbc` for standalone
// execution independent of any source.
fn loadArtifact(path: Text): ArtifactResult [io] = {
  if let Some(content) = readFileBytes(path) {
    val decoded = decodeArtifact(content)
    if not Text.eq(decoded.problem, "") then { decoded }
    else if not Text.eq(decoded.buildHash, compilerBuildHash()) then {
      ArtifactResult { code: [], sourceHash: decoded.sourceHash, buildHash: decoded.buildHash, problem: "E0406 bytecode artifact `" ++ path ++ "` was built by a different compiler build - rebuild it with `lume build` before running it with `exec`" }
    } else { decoded }
  }
  else { ArtifactResult { code: [], sourceHash: "", buildHash: "", problem: "E0405 cannot read bytecode artifact `" ++ path ++ "`" } }
}

fn importedModules(source: Text): List<Text> = {
  val tokens = lex(source)
  var modules: List<Text> = []
  var index = skipNewlines(tokens, 0)
  var scanning = true
  while scanning and not Text.eq(at(tokens, index).kind, "eof") {
    if Text.eq(at(tokens, index).text, "use") then {
      val moduleName = at(tokens, index + 1)
      if Text.eq(moduleName.kind, "name") then { modules = List.push(modules, moduleName.text) }
      while not Text.eq(at(tokens, index).kind, "newline") and not Text.eq(at(tokens, index).kind, "eof") { index = index + 1 }
      index = skipNewlines(tokens, index)
    } else { scanning = false }
  }
  modules
}

// Plain found/dep pair, not Option<PackageDep> - Certo's codegen mishandles
// Option wrapping a multi-field record (confirmed: "operand of type
// PackageDep where arithmetic or pointer type is required" from the C
// compiler), so this mirrors MatchContextPop/IfExprContextPop's own
// established always-populated-struct pattern instead.
type FindDepResult = {
  found: Bool
  dep: PackageDep
}

fn findDep(deps: List<PackageDep>, name: Text): FindDepResult = {
  var index = 0
  var found = false
  var matched = PackageDep { name: "", path: "", dependencyNames: [] }
  while index < List.len(deps) and not found {
    val dep = List.getOrPanic(deps, index)
    if Text.eq(dep.name, name) then {
      found = true
      matched = dep
    }
    index = index + 1
  }
  FindDepResult { found: found, dep: matched }
}

// The subset of `allDeps` a package whose own manifest declares `names` is
// allowed to `use` - see loadModule's own crossedName handling below.
fn depsVisibleTo(allDeps: List<PackageDep>, names: List<Text>): List<PackageDep> = {
  var visible: List<PackageDep> = []
  for dep in allDeps {
    if containsName(names, dep.name) then { visible = List.push(visible, dep) }
  }
  visible
}

fn readDependencyNames(namesArray: JsonValue): List<Text> = {
  var names: List<Text> = []
  if JsonValue.isArray(namesArray) then {
    var index = 0
    while index < JsonValue.length(namesArray) {
      // JsonValue.atText on a plain string array element returns its raw
      // JSON-encoded text, quotes included (confirmed directly: "foo", not
      // foo) - re-parsing it as its own one-value JSON document and reading
      // that back with asText is what actually unwraps the string, mirroring
      // how every array-of-objects site elsewhere in this file already
      // reparses JsonValue.atText's own output rather than using it as-is.
      names = List.push(names, JsonValue.asText(Json.parse(JsonValue.atText(namesArray, index))))
      index = index + 1
    }
  }
  names
}

// Two lists: every package resolved anywhere in the tree (needed to locate
// any of their files by path once module resolution crosses into one), and
// the subset the *root* app's own files may `use` directly - its own
// declared dependencies, not the whole transitively-resolved set (see
// loadModule's crossedName handling for how a deeper package's own,
// narrower visibility is computed once resolution crosses into it).
type PackageContext = {
  allDeps: List<PackageDep>
  visibleDeps: List<PackageDep>
  problem: Text
}

// The file's absence means "no dependencies" (an ordinary project with
// no lume.json/lume.lock.json), reported as no problem at all - but a
// PRESENT file that doesn't have the shape lume install always writes
// (not an object, or "resolved"/"direct" not arrays) is corruption, not
// an empty project, and is reported as one instead of silently resolving
// to zero dependencies - confirmed live that the latter produces a
// confusing "cannot read module" error pointing nowhere near the real
// cause. A resolved entry's own "dependencies" being missing/empty is
// left alone: readDependencyNames already treats that as an ordinary
// leaf package with nothing further to declare, not corruption.
fn loadPackageContext(dir: Text): PackageContext [io] = {
  val lockPath = Path.join(dir, "lume.lock.json")
  if let Some(source) = readFile(lockPath) {
    val root = Json.parse(source)
    val depsArray = JsonValue.get(root, "resolved")
    val directArray = JsonValue.get(root, "direct")
    if not JsonValue.isObject(root) or not JsonValue.isArray(depsArray) or not JsonValue.isArray(directArray) then {
      PackageContext { allDeps: [], visibleDeps: [], problem: "E0738 cannot parse lock file `" ++ lockPath ++ "`" }
    } else {
      var allDeps: List<PackageDep> = []
      var index = 0
      while index < JsonValue.length(depsArray) {
        val entry = Json.parse(JsonValue.atText(depsArray, index))
        val name = JsonValue.asText(JsonValue.get(entry, "name"))
        val relativePath = JsonValue.asText(JsonValue.get(entry, "path"))
        val ownNames = readDependencyNames(JsonValue.get(entry, "dependencies"))
        allDeps = List.push(allDeps, PackageDep { name: name, path: packageDirPath(dir, relativePath), dependencyNames: ownNames })
        index = index + 1
      }
      val directNames = readDependencyNames(directArray)
      PackageContext { allDeps: allDeps, visibleDeps: depsVisibleTo(allDeps, directNames), problem: "" }
    }
  } else { PackageContext { allDeps: [], visibleDeps: [], problem: "" } }
}

fn resolveModulePath(path: Text, moduleName: Text, visibleDeps: List<PackageDep>): ModulePathResult = {
  val dot = Text.indexOf(moduleName, ".") ?? -1
  val head = if dot >= 0 then Text.slice(moduleName, 0, dot) else moduleName
  val localPath = Path.join(Path.dirname(path), Text.replace(moduleName, ".", "/") ++ ".lume")
  val found = findDep(visibleDeps, head)
  if found.found then {
    if dot >= 0 then {
      val rest = Text.slice(moduleName, dot + 1, Text.len(moduleName))
      ModulePathResult { path: Path.join(found.dep.path, Text.replace(rest, ".", "/") ++ ".lume"), crossedName: head }
    } else { ModulePathResult { path: localPath, crossedName: "" } }
  } else { ModulePathResult { path: localPath, crossedName: "" } }
}

fn loadModule(path: Text, active: List<Text>, alreadyLoaded: List<Text>, allDeps: List<PackageDep>, visibleDeps: List<PackageDep>): ModuleLoad [io] = {
  if containsName(alreadyLoaded, path) then { ModuleLoad { source: "", loadedPaths: alreadyLoaded, problem: "" } }
  else if containsName(active, path) then { ModuleLoad { source: "", loadedPaths: alreadyLoaded, problem: "E0702 module import cycle at `" ++ path ++ "`" } }
  else if let Some(source) = readFile(path) {
    val nextActive = List.push(active, path)
    var loadedPaths = alreadyLoaded
    var combined = ""
    var problem = ""
    for moduleName in importedModules(source) {
      if Text.eq(problem, "") then {
        val resolved = resolveModulePath(path, moduleName, visibleDeps)
        // Same package (crossedName == "") keeps this file's own visibility
        // unchanged; crossing into a declared dependency narrows it to
        // *that* package's own declared names, not the whole flat tree -
        // this is what actually enforces isolation: a dependency can only
        // `use` what it itself declared, never a sibling it never asked for.
        val crossedDep = findDep(allDeps, resolved.crossedName)
        val nextVisible = if Text.eq(resolved.crossedName, "") then visibleDeps else if crossedDep.found then depsVisibleTo(allDeps, crossedDep.dep.dependencyNames) else []
        val dependency = loadModule(resolved.path, nextActive, loadedPaths, allDeps, nextVisible)
        if not Text.eq(dependency.problem, "") then { problem = dependency.problem }
        else {
          combined = combined ++ dependency.source
          loadedPaths = dependency.loadedPaths
        }
      }
    }
    if Text.eq(problem, "") then {
      ModuleLoad { source: combined ++ source ++ newline(), loadedPaths: List.push(loadedPaths, path), problem: "" }
    } else { ModuleLoad { source: "", loadedPaths: loadedPaths, problem: problem } }
  } else {
    ModuleLoad { source: "", loadedPaths: alreadyLoaded, problem: "E0701 cannot read module `" ++ path ++ "`" }
  }
}

fn loadProgram(path: Text): ModuleLoad [io] = {
  val pkgContext = loadPackageContext(Path.dirname(path))
  if not Text.eq(pkgContext.problem, "") then {
    ModuleLoad { source: "", loadedPaths: [], problem: pkgContext.problem }
  } else { loadModule(path, [], [], pkgContext.allDeps, pkgContext.visibleDeps) }
}

// The single source of truth for "is this manifest valid," root package
// or dependency alike - every caller propagates its Err message as-is
// rather than re-deriving its own code, so "unreadable" and "malformed"
// can never end up reported under different codes depending on where in
// the dependency tree the manifest happens to sit.
fn readManifestVersion(manifestPath: Text): Result<Text, Text> = {
  if let Some(source) = readFile(manifestPath) {
    val root = Json.parse(source)
    if not JsonValue.isObject(root) then { Err("E0705 cannot read manifest `" ++ manifestPath ++ "`") }
    else {
      val name = JsonValue.get(root, "name")
      val version = JsonValue.get(root, "version")
      if not JsonValue.isString(name) or not JsonValue.isString(version) then {
        Err("E0737 manifest `" ++ manifestPath ++ "` requires string `name` and `version` fields")
      } else { Ok(JsonValue.asText(version)) }
    }
  } else { Err("E0705 cannot read manifest `" ++ manifestPath ++ "`") }
}

// The plain dependency names a manifest itself declares - used to build
// each lock-file entry's own "dependencies" list, so module resolution can
// later tell "this package declared X" apart from "X merely exists
// somewhere in the resolved tree" (see resolveModulePath/loadModule).
fn readManifestDependencyNames(manifestPath: Text): List<Text> [io] = {
  if let Some(source) = readFile(manifestPath) {
    val depsArray = JsonValue.get(Json.parse(source), "dependencies")
    if JsonValue.isArray(depsArray) then {
      var names: List<Text> = []
      var index = 0
      while index < JsonValue.length(depsArray) {
        val entry = Json.parse(JsonValue.atText(depsArray, index))
        names = List.push(names, JsonValue.asText(JsonValue.get(entry, "name")))
        index = index + 1
      }
      names
    } else { [] }
  } else { [] }
}

// Path.join never collapses ".." segments (confirmed empirically: joining
// "../b" with "../a" produces the literal string "../b/../a", not "..").
// Without normalizing, two routes to the same physical directory (the
// common shape of both a genuine cycle and a legitimate diamond
// dependency) produce different strings and never compare equal, so
// resolveDependencies's cycle/conflict checks below would misfire -
// masking a real cycle as an "ambiguous name" instead. Collapsing here
// once, right where a root-relative path is computed, keeps every
// downstream comparison (and the path actually written to the lock file)
// consistent and human-readable.
fn normalizePath(path: Text): Text = {
  var stack: List<Text> = []
  for segment in Text.split(path, "/") {
    if Text.eq(segment, "..") then {
      if List.len(stack) == 0 then { stack = List.push(stack, segment) }
      else if Text.eq(List.getOrPanic(stack, List.len(stack) - 1), "..") then { stack = List.push(stack, segment) }
      else { stack = List.slice(stack, 0, List.len(stack) - 1) }
    } else if not Text.eq(segment, ".") and not Text.eq(segment, "") then {
      stack = List.push(stack, segment)
    }
  }
  val joined = Text.join(stack, "/")
  // Splitting a POSIX absolute path ("/a/b") on "/" produces a leading
  // empty segment, which the loop above discards the same as "." - correct
  // for an ordinary relative path, but it silently turns an absolute path
  // into a relative-looking one. Confirmed live: this broke a local `path`
  // dependency declared inside a git-resolved package (resolveDependencies)
  // on Linux/macOS, where the git cache root is a POSIX absolute path -
  // packageDirPath's isAbsolutePath check no longer recognized it as
  // absolute once normalizePath had eaten its leading "/", so it got
  // silently re-joined onto the project root instead of used as-is.
  // Re-prepending here restores the one bit normalizePath must never drop.
  if Text.startsWith(path, "/") then "/" ++ joined else joined
}

// A local-path dependency's recorded path is always relative to the
// project root - every existing call site turns it back into a real
// location via Path.join(root, storedPath). A git-resolved dependency's
// path is different in kind: it points into the shared clone cache
// (resolveGitDependency), entirely outside the project tree, so it's
// stored absolute. Path.join is pure string concatenation (confirmed
// against Certo's own certo_path_join - it never special-cases an
// absolute second argument the way POSIX path.join does), so blindly
// joining an absolute stored path onto root would silently produce a
// nonsense combined string instead of erroring loudly. Every site that
// used to write `Path.join(root, storedPath)` goes through this instead,
// so a git-resolved entry's absolute path is used as-is.
fn isAbsolutePath(path: Text): Bool = {
  Text.startsWith(path, "/") or Text.startsWith(path, "\\") or
    (Text.len(path) > 1 and Text.eq(charAt(path, 1), ":") and
      Text.contains("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", charAt(path, 0)))
}

fn packageDirPath(root: Text, storedPath: Text): Text = {
  if isAbsolutePath(storedPath) then storedPath else Path.join(root, storedPath)
}

fn findResolvedPath(resolved: List<ResolvedDep>, name: Text): Text? = {
  var index = 0
  var found = false
  var path = ""
  while index < List.len(resolved) and not found {
    val dep = List.getOrPanic(resolved, index)
    if Text.eq(dep.name, name) then {
      found = true
      path = dep.path
    }
    index = index + 1
  }
  if found then Some(path) else None
}

// Shells out to a real `git` binary, no timeout - a clone/checkout can
// legitimately take longer than this project's other subprocess uses ever
// need to wait for. Returns trimmed stdout on success, trimmed stderr on
// failure, for resolveGitDependency to fold into an E0748 message.
fn runGit(args: List<Text>): Result<Text, Text> [io] = {
  val result = Process.run("git", args, "", 0)
  if ProcessResult.exitCode(result) == 0 then { Ok(Text.trim(ProcessResult.stdout(result))) }
  else { Err(Text.trim(ProcessResult.stderr(result))) }
}

// Where cloned git dependencies are cached, shared across every project on
// this machine (not per-project) - this is what gives the resolved-commit
// cache below a real reason to exist: two projects pinned to the same
// package/commit reuse one clone instead of duplicating it. LUME_HOME lets
// this be overridden; otherwise falls back to the platform home directory,
// same lookup order a real shell would use. getEnv-sourced paths on
// Windows come back backslash-separated - normalized to forward slashes
// here, once, so every path built under this root stays uniformly
// forward-slash (normalizePath, used when a local dependency is nested
// inside a git-resolved one, only ever splits on "/"). A relative fallback
// (".") used to be silently accepted here when none of LUME_HOME/
// USERPROFILE/HOME were set (a minimal container, a stripped CI
// environment) - packageDirPath's whole point is telling an absolute
// cache path apart from a project-relative one, so a cache root that
// isn't genuinely absolute defeats it in a way that's worse than erroring
// loudly: it silently re-roots the "shared" cache under whatever project
// happens to run first. Reported as a Result instead.
fn gitCacheRoot(): Result<Text, Text> = {
  val base = if let Some(lumeHome) = getEnv("LUME_HOME") { lumeHome }
             else if let Some(userProfile) = getEnv("USERPROFILE") { userProfile }
             else if let Some(home) = getEnv("HOME") { home }
             else { "" }
  if Text.eq(base, "") then {
    Err("E0748 git dependency cache: none of LUME_HOME, USERPROFILE, or HOME is set, and the shared clone cache requires an absolute, machine-stable location - set LUME_HOME explicitly")
  } else {
    Ok(Path.join(Text.replace(base, "\\", "/"), ".lume/cache/git"))
  }
}

// Best-effort: strips the two most common cosmetic differences between two
// URL spellings of the literal same repository (a trailing slash, a
// trailing ".git" suffix) before the URL is hashed into a cache key, so a
// diamond dependency reached via two such spellings still shares one
// cache entry instead of spuriously tripping E0708. Does not unify a
// genuinely different URL form (ssh vs https, or a different host alias)
// - that needs real URL parsing, out of scope for this pass.
fn canonicalizeGitUrl(url: Text): Text = {
  var result = url
  while Text.endsWith(result, "/") { result = Text.slice(result, 0, Text.len(result) - 1) }
  if Text.endsWith(result, ".git") then { result = Text.slice(result, 0, Text.len(result) - 4) }
  result
}

fn looksLikeCommitSha(ref: Text): Bool = {
  if Text.len(ref) != 40 then { false }
  else {
    var allHex = true
    var index = 0
    while index < 40 and allHex {
      if not Text.contains("0123456789abcdefABCDEF", charAt(ref, index)) then { allHex = false }
      index = index + 1
    }
    allHex
  }
}

// Best-effort fast path: resolves `ref` to a commit SHA via one
// lightweight network round-trip (no object transfer), so a cache hit can
// skip a full clone entirely. Deliberately conservative - only trusts the
// result when `git ls-remote` returns exactly one non-empty line (an
// unambiguous branch or lightweight-tag match). An annotated tag returns
// two lines (the tag object and the peeled commit `^{}`) and is left to
// fall through to the full clone below rather than risk picking the
// wrong one.
fn lsRemoteSha(gitUrl: Text, ref: Text): Text? = {
  val result = runGit(["ls-remote", "--quiet", gitUrl, ref])
  var sha: Text? = None
  if let Ok(output) = result {
    var nonEmpty: List<Text> = []
    for line in Text.split(output, "\n") {
      if not Text.eq(Text.trim(line), "") then { nonEmpty = List.push(nonEmpty, line) }
    }
    if List.len(nonEmpty) == 1 then {
      val line = List.getOrPanic(nonEmpty, 0)
      val tab = Text.indexOf(line, "\t") ?? -1
      if tab > 0 then { sha = Some(Text.slice(line, 0, tab)) }
    }
  }
  sha
}

// Recursively copies `from` into `to`, skipping any entry literally named
// `excludeName` at any depth - the fallback for when renameFile can't
// place a resolved clone in the cache (see resolveGitDependency: Windows'
// MoveFileExA, called without MOVEFILE_COPY_ALLOWED, fails across
// volumes, which a redirected/network-mounted home directory on a
// different drive than the system temp directory triggers on every
// single git dependency). `.git` itself is always excluded - nothing
// past this point ever reads a cached dependency's own history back, only
// its checked-out files. Byte-based (readFileBytes/writeFileBytes), not
// text-based: a package's files aren't guaranteed UTF-8-safe-
// roundtrippable, and silently mangling one on copy would be worse than
// the rename failure this exists to work around.
fn copyTreeExcluding(from: Text, to: Text, excludeName: Text): Bool = {
  var ok = makeDir(to)
  if ok then {
    if let Some(entries) = listDir(from) {
      for entry in entries {
        if ok and not Text.eq(entry, excludeName) then {
          val src = Path.join(from, entry)
          val dst = Path.join(to, entry)
          if isDirectory(src) then {
            if not copyTreeExcluding(src, dst, excludeName) then { ok = false }
          } else if let Some(content) = readFileBytes(src) {
            if not writeFileBytes(dst, content) then { ok = false }
          } else { ok = false }
        }
      }
    } else { ok = false }
  }
  ok
}

// A directory `git clone` is guaranteed not to see as already-existing -
// deliberately not tempDirPath()/fixture.temp_dir() directly, though both
// now share the same uniqueTempSubdir probing (see tempDirPath's own
// comment) rather than trusting a single computed name to be unique.
// Once a candidate path has actually held a real git clone, removeDir
// can't necessarily clean it back up afterward either - git deliberately
// writes its loose object files read-only, which Windows' DeleteFileA
// refuses without an explicit attribute change certo_remove_dir_all_impl
// doesn't make, so a colliding path could be left non-empty even after
// "cleanup." Probing with isDirectory and bumping a counter sidesteps
// both problems the same way: a collision just means try the next
// candidate, never reuse or force-clean the one that's already there.
fn uniqueCloneTmpDir(): Text = uniqueTempSubdir("lume_git_clone")

// Resolves a `{git, ref}` manifest entry to a local absolute clone
// directory - the one thing resolveDependencies needs to fold a git
// source into the same recursive walk a local `path` entry already goes
// through (see packageDirPath).
//
// Deliberately keyed by (git URL, resolved commit) rather than (URL, ref):
// `ref` can be a floating branch name, but the cache - and the lock file
// entry this feeds - both need a stable, immutable identity. Matches
// ROADMAP.md's own "Distribution and interoperability" design sketch this
// implements.
fn resolveGitDependency(gitUrl: Text, ref: Text): Result<Text, Text> [io] = {
  val cacheRootResult = gitCacheRoot()
  var problem = ""
  var resultPath = ""
  if let Err(message) = cacheRootResult { problem = message }
  else if let Ok(cacheRoot) = cacheRootResult {
    val urlCacheDir = Path.join(cacheRoot, Crypto.sha256(canonicalizeGitUrl(gitUrl)))
    // Fast paths, tried before ever paying for a full clone: a literal
    // commit SHA needs no network at all (just a cache-directory check);
    // otherwise a single ls-remote round-trip can confirm the cache
    // already has the answer. Only ever used to shortcut to an already-
    // cached directory - if either comes back empty, or the cache
    // doesn't have that commit yet, this falls through to the full
    // clone/checkout/rev-parse below, which is always correct regardless
    // of what `ref` turns out to mean.
    val fastShaOpt = if looksLikeCommitSha(ref) then Some(ref) else lsRemoteSha(gitUrl, ref)
    var fastHit = ""
    if let Some(fastSha) = fastShaOpt {
      val candidate = Path.join(urlCacheDir, fastSha)
      if isDirectory(candidate) then { fastHit = candidate }
    }
    if not Text.eq(fastHit, "") then {
      resultPath = fastHit
    } else {
      val tmpDir = uniqueCloneTmpDir()
      val cloneResult = runGit(["clone", "--quiet", gitUrl, tmpDir])
      if let Err(message) = cloneResult {
        removeDir(tmpDir)
        problem = "E0748 git dependency `" ++ gitUrl ++ "` failed: " ++ message
      } else {
        val checkoutResult = runGit(["-C", tmpDir, "checkout", "--quiet", ref])
        if let Err(message) = checkoutResult {
          removeDir(tmpDir)
          problem = "E0748 git dependency `" ++ gitUrl ++ "` failed: " ++ message
        } else {
          val shaResult = runGit(["-C", tmpDir, "rev-parse", "HEAD"])
          if let Err(message) = shaResult {
            removeDir(tmpDir)
            problem = "E0748 git dependency `" ++ gitUrl ++ "` failed: " ++ message
          } else if let Ok(sha) = shaResult {
            val finalDir = Path.join(urlCacheDir, sha)
            if isDirectory(finalDir) then {
              // Another install already resolved this exact (url, commit)
              // pair - reuse it rather than clobbering it with this
              // redundant clone, matching the point of a shared cache.
              removeDir(tmpDir)
              resultPath = finalDir
            } else if makeDir(urlCacheDir) and renameFile(tmpDir, finalDir) then {
              resultPath = finalDir
            } else if makeDir(urlCacheDir) and copyTreeExcluding(tmpDir, finalDir, ".git") then {
              removeDir(tmpDir)
              resultPath = finalDir
            } else {
              removeDir(tmpDir)
              problem = "E0748 git dependency `" ++ gitUrl ++ "` failed: could not place resolved clone in cache at `" ++ finalDir ++ "`"
            }
          }
        }
      }
    }
  }
  if Text.eq(problem, "") then Ok(resultPath) else Err(problem)
}

fn resolveDependencies(rootDir: Text, rootRelative: Text, active: List<Text>, activeGitRefs: List<Text>, resolved: List<ResolvedDep>): ResolveOutcome [io] = {
  val manifestPath = Path.join(packageDirPath(rootDir, rootRelative), "lume.json")
  if let Some(source) = readFile(manifestPath) {
    val depsArray = JsonValue.get(Json.parse(source), "dependencies")
    var currentResolved = resolved
    var problem = ""
    if JsonValue.isArray(depsArray) then {
      var index = 0
      while index < JsonValue.length(depsArray) and Text.eq(problem, "") {
        val entry = Json.parse(JsonValue.atText(depsArray, index))
        val depName = JsonValue.asText(JsonValue.get(entry, "name"))
        val declaredPath = JsonValue.asText(JsonValue.get(entry, "path"))
        val declaredGit = JsonValue.asText(JsonValue.get(entry, "git"))
        val declaredRef = JsonValue.asText(JsonValue.get(entry, "ref"))
        val hasPath = not Text.eq(declaredPath, "")
        val hasGit = not Text.eq(declaredGit, "")
        // Exactly one of `path`/`git` - both or neither is the same class
        // of manifest error as the existing missing-name/version check
        // (E0737): malformed input, not an empty/absent dependency. `git`
        // without `ref` is folded into the same code rather than a
        // dedicated one - both are "this entry doesn't declare a usable
        // source," and a caller never needs to tell them apart
        // programmatically, only read the message.
        val gitRefKey = declaredGit ++ "@" ++ declaredRef
        if (hasPath and hasGit) or (not hasPath and not hasGit) or (hasGit and Text.eq(declaredRef, "")) then {
          problem = "E0747 dependency `" ++ depName ++ "` in `" ++ manifestPath ++ "` must declare exactly one of `path`/`git`, and `git` requires `ref`"
        } else if hasGit and containsName(activeGitRefs, gitRefKey) then {
          // Cheap, I/O-free pre-check for the common literal-cycle case (the
          // same git+ref pair already being resolved higher up the active
          // chain) - catches it before paying for a real clone, which the
          // resolved-path-based E0709 check below can't do until AFTER
          // resolveGitDependency returns (it needs the resolved path to
          // compare against). Not a replacement for that check: a cycle
          // reached via two differently-spelled (git, ref) pairs that
          // happen to resolve to the same physical commit still needs the
          // path-based check after resolution - this only short-circuits
          // the literal, no-clone-needed case.
          problem = "E0709 dependency cycle at `" ++ depName ++ "`"
        } else {
          val gitResolution = if hasGit then resolveGitDependency(declaredGit, declaredRef) else Ok("")
          if let Err(message) = gitResolution {
            problem = message
          } else if let Ok(gitPath) = gitResolution {
            // A git source's resolved path is already absolute (it lives in
            // the shared clone cache, outside the project tree) - unlike a
            // local `path` entry, it's used as-is, never joined against
            // `rootRelative` or run through normalizePath's `..`-collapsing
            // (see packageDirPath).
            val depRootRelative = if hasGit then gitPath else normalizePath(if Text.eq(rootRelative, "") then declaredPath else Path.join(rootRelative, declaredPath))
            if containsName(active, depRootRelative) then {
              // Checked before `resolved`, not after: an entry is added to
              // `resolved` (below) before recursing into ITS OWN dependencies,
              // so by the time a real cycle closes back onto an ancestor,
              // that ancestor already has a "resolved" entry despite its own
              // recursive call not having returned yet. Only `active` (the
              // in-progress stack) reliably distinguishes "still being
              // resolved higher up" from "genuinely finished" - checking it
              // first is what makes a true cycle actually surface as E0709
              // instead of silently matching the premature `resolved` entry.
              problem = "E0709 dependency cycle at `" ++ depName ++ "`"
            } else if let Some(existingPath) = findResolvedPath(currentResolved, depName) {
              if not Text.eq(existingPath, depRootRelative) then {
                problem = "E0708 dependency `" ++ depName ++ "` resolves to two different paths: `" ++ existingPath ++ "` and `" ++ depRootRelative ++ "`"
              }
            } else {
              val depManifestPath = Path.join(packageDirPath(rootDir, depRootRelative), "lume.json")
              if let Ok(depVersion) = readManifestVersion(depManifestPath) {
                val depDependencyNames = readManifestDependencyNames(depManifestPath)
                currentResolved = List.push(currentResolved, ResolvedDep { name: depName, path: depRootRelative, version: depVersion, dependencyNames: depDependencyNames, git: if hasGit then declaredGit else "", ref: if hasGit then declaredRef else "" })
                val nextActiveGitRefs = if hasGit then List.push(activeGitRefs, gitRefKey) else activeGitRefs
                val nested = resolveDependencies(rootDir, depRootRelative, List.push(active, depRootRelative), nextActiveGitRefs, currentResolved)
                if not Text.eq(nested.problem, "") then { problem = nested.problem }
                else { currentResolved = nested.resolved }
              } else if let Err(message) = readManifestVersion(depManifestPath) {
                problem = message
              }
            }
          }
        }
        index = index + 1
      }
    }
    ResolveOutcome { resolved: currentResolved, problem: problem }
  } else { ResolveOutcome { resolved: resolved, problem: "E0705 cannot read manifest `" ++ manifestPath ++ "`" } }
}

// Certo's own `<`/`<=` on two `Text` operands type-checks (infer_expr.rs
// only unifies both operand types for Lt/LtEq/Gt/GtEq, it doesn't require
// them to be numeric) but compiles to a raw C `<` on the underlying
// pointer (emit_mir.rs's generic fallback - only `Decimal` gets a real
// runtime comparison function) - that's a pointer comparison, not a
// content comparison, so it can't be used to sort file paths for a stable
// hash. Byte-by-byte comparison via the same Bytes.fromText/Bytes.byteAt
// primitives the lexer already uses is the safe alternative.
fn textLessThan(a: Text, b: Text): Bool = {
  val aBytes = Bytes.fromText(a)
  val bBytes = Bytes.fromText(b)
  val aLen = Bytes.length(aBytes)
  val bLen = Bytes.length(bBytes)
  val minLen = if aLen < bLen then aLen else bLen
  var index = 0
  var decided = false
  var less = aLen < bLen
  while index < minLen and not decided {
    val ac = Bytes.byteAt(aBytes, index)
    val bc = Bytes.byteAt(bBytes, index)
    if ac != bc then {
      less = ac < bc
      decided = true
    }
    index = index + 1
  }
  less
}

// No List-set/mutate-by-index exists anywhere in this file (only
// push/getOrPanic/concat/slice - see lspLevenshtein's own comment on the
// same gap), so this is a selection sort built the same accumulate-then-
// rebuild way: repeatedly pull the minimum out of `remaining` (via slice
// + concat, not an in-place write) and push it onto `sorted`. A package's
// source files number in the single digits, so the quadratic cost here
// is irrelevant.
fn sortTexts(items: List<Text>): List<Text> = {
  var remaining = items
  var sorted: List<Text> = []
  while List.len(remaining) > 0 {
    var minIndex = 0
    var i = 1
    while i < List.len(remaining) {
      if textLessThan(List.getOrPanic(remaining, i), List.getOrPanic(remaining, minIndex)) then { minIndex = i }
      i = i + 1
    }
    sorted = List.push(sorted, List.getOrPanic(remaining, minIndex))
    remaining = List.concat(List.slice(remaining, 0, minIndex), List.slice(remaining, minIndex + 1, List.len(remaining)))
  }
  sorted
}

// A dependency's own source hash for `lume.lock.json` - catches a `.lume`
// file hand-edited after `lume install` last ran, which a manifest/version
// hash alone can't (the manifest doesn't change just because a source file
// did). Hashes every `.lume` file under the dependency's directory
// (recursively, matching how loadModule can reach a file at any depth
// under a dependency's root, not just its top level), sorted by path so
// the hash doesn't depend on directory-listing order, each entry prefixed
// with its path (relative to packageDir, so the hash is independent of
// where the package happens to be checked out) so a rename is also caught,
// not just a content edit.
fn hashPackageSource(packageDir: Text): Text [io] = {
  val files = sortTexts(walkDir(packageDir, 0, 32))
  var combined = ""
  for path in files {
    if Text.endsWith(path, ".lume") then {
      val relative = if Text.startsWith(path, packageDir) then Text.slice(path, Text.len(packageDir), Text.len(path)) else path
      if let Some(content) = readFile(path) {
        combined = combined ++ relative ++ "\n" ++ content ++ "\n"
      }
    }
  }
  Crypto.sha256(combined)
}

// Everything `installPackages` needs to write a lock file, minus the
// actual writing - shared by plain `lume install` (writes this) and
// `lume install --check` (compares this against what's already on disk
// instead, to catch a manifest that changed since the lock file was
// last generated without re-running install).
fn computeLockContent(dir: Text, manifestPath: Text): Result<Text, Text> = {
  if let Err(message) = readManifestVersion(manifestPath) { Err(message) }
  else {
    val outcome = resolveDependencies(dir, "", [], [], [])
    if not Text.eq(outcome.problem, "") then { Err(outcome.problem) }
    else {
      val lockDeps = Json.array()
      for dep in outcome.resolved {
        val lockEntry = Json.object()
        JsonValue.set(lockEntry, "name", Json.string(dep.name))
        JsonValue.set(lockEntry, "path", Json.string(dep.path))
        JsonValue.set(lockEntry, "version", Json.string(dep.version))
        JsonValue.set(lockEntry, "sourceHash", Json.string(hashPackageSource(packageDirPath(dir, dep.path))))
        // Only present for a git-sourced entry, not written at all (rather
        // than written as "") for a local-path one - confirmed live that
        // writing it unconditionally breaks `install --check` for every
        // project that predates this feature: their existing lock file has
        // no "git"/"ref" keys at all, `--check` compares the recomputed
        // content against it with exact string equality, and a plain-path
        // project (the overwhelming majority - nothing about git deps)
        // would otherwise report a spurious E0739 the moment the binary is
        // upgraded, even though nothing about its own dependencies changed.
        if not Text.eq(dep.git, "") then {
          JsonValue.set(lockEntry, "git", Json.string(dep.git))
          JsonValue.set(lockEntry, "ref", Json.string(dep.ref))
        }
        val ownNames = Json.array()
        for depName in dep.dependencyNames { JsonValue.push(ownNames, Json.string(depName)) }
        JsonValue.set(lockEntry, "dependencies", ownNames)
        JsonValue.push(lockDeps, lockEntry)
      }
      // Which of the root app's own direct dependencies it may `use`
      // directly - distinct from the full "resolved" list below, which
      // also contains transitive-only packages a *deeper* dependency
      // declared, not the app itself (see loadProgram/loadModule).
      val directNames = Json.array()
      for name in readManifestDependencyNames(manifestPath) { JsonValue.push(directNames, Json.string(name)) }
      val lockRoot = Json.object()
      JsonValue.set(lockRoot, "resolved", lockDeps)
      JsonValue.set(lockRoot, "direct", directNames)
      Ok(Json.stringify(lockRoot))
    }
  }
}

fn installPackages(dir: Text, checkOnly: Bool): Unit [io] = {
  val manifestPath = Path.join(dir, "lume.json")
  val computed = computeLockContent(dir, manifestPath)
  if let Err(message) = computed {
    eprintln(message)
    Process.quit(1)
  } else if let Ok(content) = computed {
    val lockPath = Path.join(dir, "lume.lock.json")
    if checkOnly then {
      if let Some(existing) = readFile(lockPath) {
        if Text.eq(existing, content) then { println("ok") }
        else {
          eprintln("E0739 lock file `" ++ lockPath ++ "` is out of date with `" ++ manifestPath ++ "`")
          Process.quit(1)
        }
      } else {
        eprintln("E0739 lock file `" ++ lockPath ++ "` is out of date with `" ++ manifestPath ++ "`")
        Process.quit(1)
      }
    } else if writeFile(lockPath, content) then { println("wrote " ++ lockPath) }
    else {
      eprintln("E0707 cannot write lock file `" ++ lockPath ++ "`")
      Process.quit(1)
    }
  }
}

fn compileSource(source: Text): CompileResult = compile(lex(source))

// A blocking header read: readLine() strips only the trailing '\n', leaving a
// trailing '\r' on real clients' CRLF-terminated header lines, so lines are
// trimmed before comparison. Returns None on EOF or a message with no (or an
// unparsable) Content-Length header - both end the server loop the same way,
// since a real client never sends either. A successfully-parsed but negative
// value is treated as unparsable too: it would otherwise reach readBytes,
// which blocks forever trying to read that many bytes (confirmed live - a
// bare `Content-Length: -1` hangs the server permanently with 0% CPU, no
// way for a client to recover short of killing the process).
fn lspReadContentLength(): Int? = {
  var contentLength: Int? = None
  var done = false
  var eof = false
  while not done and not eof {
    if let Some(rawLine) = readLine() {
      val line = Text.trim(rawLine)
      if Text.eq(line, "") then { done = true }
      else if Text.startsWith(line, "Content-Length:") then {
        val parsed = parseInt(Text.trim(Text.slice(line, 15, Text.len(line))))
        if let Some(n) = parsed {
          contentLength = if n >= 0 then Some(n) else None
        } else {
          contentLength = None
        }
      }
    } else { eof = true }
  }
  if eof then None else contentLength
}

fn lspReadMessage(): Text? = {
  if let Some(length) = lspReadContentLength() { Some(readBytes(length)) } else { None }
}

// Certo's print()/println() never auto-flush stdout (only flush() does), and
// LSP's stdio transport is normally a pipe (fully buffered, not line-buffered)
// - every write here is followed by flush(), or the client would never see it.
// The carriage return is built via Char.fromInt rather than a "\r" literal:
// Certo's codegen escapes "\n" but not "\r" when folding a Text literal into
// its C source, so an embedded literal \r breaks the generated C string.
fn lspWriteMessage(body: Text): Unit [io] = {
  val cr = Char.toText(Char.fromInt(13))
  print("Content-Length: " ++ intToText(Text.len(body)) ++ cr ++ "\n" ++ cr ++ "\n" ++ body)
  flush()
}

fn lspRespond(id: JsonValue, result: JsonValue): Unit [io] = {
  val response = Json.object()
  JsonValue.set(response, "jsonrpc", Json.string("2.0"))
  JsonValue.set(response, "id", id)
  JsonValue.set(response, "result", result)
  lspWriteMessage(Json.stringify(response))
}

fn lspRespondError(id: JsonValue, code: Int, message: Text): Unit [io] = {
  val errorObject = Json.object()
  JsonValue.set(errorObject, "code", Json.int(code))
  JsonValue.set(errorObject, "message", Json.string(message))
  val response = Json.object()
  JsonValue.set(response, "jsonrpc", Json.string("2.0"))
  JsonValue.set(response, "id", id)
  JsonValue.set(response, "error", errorObject)
  lspWriteMessage(Json.stringify(response))
}

// This is an MVP diagnostics translation: compileSource (like every Lume
// compile path) reports at most one problem per call, so at most one
// Diagnostic is ever published here. Reporting every error in a file would
// need the compiler's single `problem: Text` field widened to a list first -
// a separate, much larger change, not attempted here.
fn lspPublishDiagnostics(uri: Text, problem: Text): Unit [io] = {
  val diagnostics = Json.array()
  if not Text.eq(problem, "") then {
    val info = Json.parse(diagnosticJson(problem, ""))
    val oneIndexedLine = JsonValue.asInt(JsonValue.get(info, "line"))
    val lspLine = if oneIndexedLine > 0 then oneIndexedLine - 1 else 0
    val position = Json.object()
    JsonValue.set(position, "line", Json.int(lspLine))
    JsonValue.set(position, "character", Json.int(0))
    val range = Json.object()
    JsonValue.set(range, "start", position)
    JsonValue.set(range, "end", position)
    val diagnostic = Json.object()
    JsonValue.set(diagnostic, "range", range)
    JsonValue.set(diagnostic, "severity", Json.int(1))
    JsonValue.set(diagnostic, "code", JsonValue.get(info, "code"))
    JsonValue.set(diagnostic, "source", Json.string("lume"))
    JsonValue.set(diagnostic, "message", JsonValue.get(info, "message"))
    JsonValue.push(diagnostics, diagnostic)
  }
  val params = Json.object()
  JsonValue.set(params, "uri", Json.string(uri))
  JsonValue.set(params, "diagnostics", diagnostics)
  val notification = Json.object()
  JsonValue.set(notification, "jsonrpc", Json.string("2.0"))
  JsonValue.set(notification, "method", Json.string("textDocument/publishDiagnostics"))
  JsonValue.set(notification, "params", params)
  lspWriteMessage(Json.stringify(notification))
}

// Tries the single-file compile first and only reaches for a combined
// "imports + this document" compile to answer one yes/no question - does
// resolving imports make this specific failure go away - never as the
// source of the diagnostic actually published. This sidesteps line-number
// arithmetic entirely: a diagnostic that survives both compiles is always
// the single-file one, whose line numbers are already correct for this
// document. Confirmed live before this fix: a file `use`-importing a
// function from another real file compiled and ran correctly from the
// command line, but reported a false "unknown function" diagnostic through
// lume lsp, since this function never looked at the import at all.
fn lspCheckDocument(documents: LspDocuments, uri: Text, text: Text): Unit [io] = {
  val singleFileOutcome = compileSource(text)
  if Text.eq(singleFileOutcome.problem, "") then { lspPublishDiagnostics(uri, "") }
  else {
    val importedSource = lspImportedSource(documents, lspUriToPath(uri), text)
    if Text.eq(importedSource, "") then { lspPublishDiagnostics(uri, singleFileOutcome.problem) }
    else {
      val combinedOutcome = compileSource(importedSource ++ text)
      if Text.eq(combinedOutcome.problem, "") then { lspPublishDiagnostics(uri, "") }
      else { lspPublishDiagnostics(uri, singleFileOutcome.problem) }
    }
  }
}

// Certo's Map is pointer-equality keyed (crates/stdlib/src/collections.rs:
// "Map (open-addressing, pointer-equality keys)"), confirmed live: two
// content-identical Text values parsed from separate JSON-RPC messages
// don't match as Map keys even though Text.eq(a, b) is true. A URI arriving
// in one message and looked up from another is exactly that case, so the
// document store is two parallel lists searched by Text.eq instead - open
// documents in one LSP session number in the single digits, so an O(n) scan
// costs nothing that matters.
type LspDocuments = {
  uris: List<Text>
  texts: List<Text>
}

type LspState = {
  documents: LspDocuments
  running: Bool
  workspaceRoot: Text
}

fn lspDocumentIndex(uris: List<Text>, uri: Text): Int = {
  var index = 0
  var result = -1
  while index < List.len(uris) and result == -1 {
    if Text.eq(List.getOrPanic(uris, index), uri) then { result = index }
    index = index + 1
  }
  result
}

fn lspDocumentsSet(documents: LspDocuments, uri: Text, text: Text): LspDocuments = {
  val existing = lspDocumentIndex(documents.uris, uri)
  if existing >= 0 then {
    var newTexts: List<Text> = []
    var index = 0
    while index < List.len(documents.texts) {
      if index == existing then { newTexts = List.push(newTexts, text) }
      else { newTexts = List.push(newTexts, List.getOrPanic(documents.texts, index)) }
      index = index + 1
    }
    LspDocuments { uris: documents.uris, texts: newTexts }
  } else {
    LspDocuments { uris: List.push(documents.uris, uri), texts: List.push(documents.texts, text) }
  }
}

fn lspDocumentsRemove(documents: LspDocuments, uri: Text): LspDocuments = {
  var newUris: List<Text> = []
  var newTexts: List<Text> = []
  var index = 0
  while index < List.len(documents.uris) {
    if not Text.eq(List.getOrPanic(documents.uris, index), uri) then {
      newUris = List.push(newUris, List.getOrPanic(documents.uris, index))
      newTexts = List.push(newTexts, List.getOrPanic(documents.texts, index))
    }
    index = index + 1
  }
  LspDocuments { uris: newUris, texts: newTexts }
}

// LSP-only declaration index: a single linear pass over tokens collecting
// the name token immediately following any fn/type/enum keyword. Covers
// top-level functions, protocol method signatures, impl methods, records,
// and enums - not local val/var bindings or generic type parameters.
// Deliberately not scanFunctions/scanRecords/scanEnums: those validate full
// structure and bail on the first error, but a definition request can
// arrive while the open document has an unrelated compile error elsewhere.
type LspDeclaration = {
  keyword: Text
  header: Int
  name: Token
}

fn lspDeclarationSites(tokens: List<Token>): List<LspDeclaration> = {
  var result: List<LspDeclaration> = []
  var index = 0
  while not Text.eq(at(tokens, index).kind, "eof") {
    val current = at(tokens, index)
    val isDeclKeyword = Text.eq(current.text, "fn") or Text.eq(current.text, "type") or Text.eq(current.text, "enum")
    if isDeclKeyword and Text.eq(at(tokens, index + 1).kind, "name") then {
      result = List.push(result, LspDeclaration { keyword: current.text, header: index, name: at(tokens, index + 1) })
    }
    index = index + 1
  }
  result
}

// Returns the text of the name-kind token covering (line, column), or ""
// if the position doesn't fall inside a name token.
fn lspNameTokenAt(tokens: List<Token>, line: Int, column: Int): Text = {
  var index = 0
  var result = ""
  while not Text.eq(at(tokens, index).kind, "eof") and Text.eq(result, "") {
    val current = at(tokens, index)
    val withinColumns = column >= current.column and column < current.column + Text.len(current.text)
    if Text.eq(current.kind, "name") and current.line == line and withinColumns then {
      result = current.text
    }
    index = index + 1
  }
  result
}

// Flat, first-match, name-only resolution - not type/scope-aware, matching
// this compiler's own flat-namespace philosophy elsewhere (hashName's
// bucket lookups). Two declarations sharing a name resolve to whichever
// appears first in the file. Returned declaration's header is -1 (never a
// real token index) when nothing matches.
fn lspFindDeclaration(sites: List<LspDeclaration>, name: Text): LspDeclaration = {
  var index = 0
  var result = LspDeclaration { keyword: "", header: -1, name: makeToken("name", "", 0, 0) }
  while index < List.len(sites) and result.header == -1 {
    val site = List.getOrPanic(sites, index)
    if Text.eq(site.name.text, name) then { result = site }
    index = index + 1
  }
  result
}

// RFC 8089's file:// form for an absolute Windows drive path is
// "file:///C:/...", not "file://C:/..." - readFile/Path.* expect
// "C:/Users/..." (no leading slash), so the extra slash before the drive
// letter must be stripped too, not just the "file://" scheme prefix.
// Confirmed live before this fix: leaving it in place made readFile fail
// to find a real file on disk that definitely existed.
fn lspUriToPath(uri: Text): Text = {
  val stripped = if Text.startsWith(uri, "file://") then Text.slice(uri, 7, Text.len(uri)) else uri
  if Text.len(stripped) > 2 and Text.eq(charAt(stripped, 0), "/") and Text.eq(charAt(stripped, 2), ":") then {
    Text.slice(stripped, 1, Text.len(stripped))
  } else { stripped }
}

// The inverse: a Windows drive path ("C:/...", detected via a colon at
// index 1) needs the extra slash reinserted to produce the standard
// three-slash "file:///C:/..." form a real editor would send - a Unix
// absolute path ("/home/...") already supplies its own leading slash, so
// plain "file://" + path already comes out as the correct "file:///home/...".
fn lspPathToUri(path: Text): Text = {
  if Text.len(path) > 1 and Text.eq(charAt(path, 1), ":") then { "file:///" ++ path }
  else { "file://" ++ path }
}

// Prefers the document store over disk - the user may have the imported
// file open too, with unsaved edits newer than what's on disk. "" covers
// both "not open and not on disk" and "genuinely empty file"; harmless
// here, since either way lspDeclarationSites on empty text finds nothing.
fn lspReadFile(documents: LspDocuments, uri: Text, path: Text): Text = {
  val documentIndex = lspDocumentIndex(documents.uris, uri)
  if documentIndex >= 0 then List.getOrPanic(documents.texts, documentIndex)
  else { readFile(path) ?? "" }
}

// An explicit top-level `found` flag, not a nested sentinel field
// (name.line == 0) read from a while loop's own condition - confirmed
// live this is a genuine Certo codegen bug ("assigning to 'int64_t' from
// incompatible type 'Token'" from the C compiler) when a loop condition
// drills into a mutated var's nested record field. findDep's own
// FindDepResult above already works around the same class of issue the
// same way, for the same reason.
// found as a top-level flag, not a nested sentinel field read from a while
// loop condition - the exact Certo codegen bug hit and worked around while
// building this resolver originally (a loop condition drilling into a
// nested record field on a mutated var produces broken C output). Storing
// an LspDeclaration - itself holding a Token - as a plain field here is
// fine; the bug is specifically about reading a nested field in a loop
// *condition*, not about storage depth.
type LspCrossFileDeclaration = {
  found: Bool
  uri: Text
  tokens: List<Token>
  declaration: LspDeclaration
}

// One level of direct `use` imports only, resolved the same way the real
// compiler resolves them for compilation (importedModules/
// resolveModulePath, already built for that) - not a transitive walk of
// the whole import graph. First match across the imports, in `use`-
// statement order, wins - same flat, first-match philosophy already used
// for same-file resolution. No package-manifest loading: resolveModulePath
// is called with an empty visibleDeps list, so a same-package `use`
// resolves correctly but a cross-package dependency's `use` won't -
// documented v1 boundary, not an oversight. Returns the token list the
// match came from too (a header index is only meaningful relative to the
// specific token list it indexes into), so callers needing more than a
// Location (e.g. hover's own signature lookup) can reuse this one walk
// instead of a second, near-duplicate one.
fn lspResolveCrossFileDeclaration(documents: LspDocuments, currentPath: Text, currentText: Text, name: Text): LspCrossFileDeclaration = {
  val modules = importedModules(currentText)
  var index = 0
  var result = LspCrossFileDeclaration { found: false, uri: "", tokens: [], declaration: LspDeclaration { keyword: "", header: -1, name: makeToken("name", "", 0, 0) } }
  while index < List.len(modules) and not result.found {
    val resolved = resolveModulePath(currentPath, List.getOrPanic(modules, index), [])
    val importedUri = lspPathToUri(resolved.path)
    val importedText = lspReadFile(documents, importedUri, resolved.path)
    if not Text.eq(importedText, "") then {
      val importedTokens = lex(importedText)
      val declaration = lspFindDeclaration(lspDeclarationSites(importedTokens), name)
      if declaration.header != -1 then { result = LspCrossFileDeclaration { found: true, uri: importedUri, tokens: importedTokens, declaration: declaration } }
    }
    index = index + 1
  }
  result
}

// Same one-level-of-direct-imports scope as lspResolveCrossFile above, for
// the same reason (not a transitive whole-graph walk). Concatenates with a
// newline separator between each import (safer than loadModule's own
// no-separator concatenation - this combined text only exists transiently
// for a yes/no compile check in lspCheckDocument below, never returned to
// a client, so it doesn't need to byte-for-byte match loadModule's own
// internal combine format). "" if there are no imports or none resolve to
// real content - this file's existing empty-sentinel convention throughout.
fn lspImportedSource(documents: LspDocuments, currentPath: Text, currentText: Text): Text = {
  val modules = importedModules(currentText)
  var combined = ""
  var index = 0
  while index < List.len(modules) {
    val resolved = resolveModulePath(currentPath, List.getOrPanic(modules, index), [])
    val importedUri = lspPathToUri(resolved.path)
    val importedText = lspReadFile(documents, importedUri, resolved.path)
    if not Text.eq(importedText, "") then { combined = combined ++ importedText ++ newline() }
    index = index + 1
  }
  combined
}

fn lspHandleDefinition(id: JsonValue, params: JsonValue, documents: LspDocuments): Unit [io] = {
  val textDocument = JsonValue.get(params, "textDocument")
  val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
  val position = JsonValue.get(params, "position")
  val requestLine = JsonValue.asInt(JsonValue.get(position, "line")) + 1
  val requestColumn = JsonValue.asInt(JsonValue.get(position, "character")) + 1
  val documentIndex = lspDocumentIndex(documents.uris, uri)
  if documentIndex >= 0 then {
    val text = List.getOrPanic(documents.texts, documentIndex)
    val requestTokens = lex(text)
    val name = lspNameTokenAt(requestTokens, requestLine, requestColumn)
    if Text.eq(name, "") then { lspRespond(id, Json.null()) }
    else {
      val declaration = lspFindDeclaration(lspDeclarationSites(requestTokens), name)
      if declaration.header != -1 then { lspRespond(id, lspLocationJson(uri, declaration.name)) }
      else {
        val crossFile = lspResolveCrossFileDeclaration(documents, lspUriToPath(uri), text, name)
        if not crossFile.found then { lspRespond(id, Json.null()) }
        else { lspRespond(id, lspLocationJson(crossFile.uri, crossFile.declaration.name)) }
      }
    }
  } else { lspRespond(id, Json.null()) }
}

// parameterTypes/functionReturnType (below) assume a *complete* signature (a
// matching `)`) - true for their existing caller (scanFunctions, called
// after the file already lexed successfully), but hover can be asked about
// a function whose signature is incomplete (mid-edit, the single most
// common real hover moment), and those helpers would scan forward for
// tokens that never arrive. Confirmed directly this class of risk already
// exists compiler-wide (lume check on already-malformed generic syntax
// already panics with "list index out of bounds" today, unrelated to
// hover) - this guard covers only the specific new exposure hover adds.
fn lspHasMatchingParen(tokens: List<Token>, header: Int): Bool = {
  var index = header
  var found = false
  while not found and not Text.eq(at(tokens, index).kind, "eof") {
    if Text.eq(at(tokens, index).text, ")") then { found = true }
    index = index + 1
  }
  found
}

fn lspDeclarationSignature(tokens: List<Token>, declaration: LspDeclaration): Text = {
  if Text.eq(declaration.keyword, "fn") and lspHasMatchingParen(tokens, declaration.header) then {
    val names = parameterNames(tokens, declaration.header)
    val types = parameterTypes(tokens, declaration.header)
    var params: List<Text> = []
    var index = 0
    while index < List.len(names) {
      params = List.push(params, List.getOrPanic(names, index) ++ ": " ++ List.getOrPanic(types, index))
      index = index + 1
    }
    "fn " ++ declaration.name.text ++ "(" ++ Text.join(params, ", ") ++ "): " ++ functionReturnType(tokens, declaration.header)
  } else {
    declaration.keyword ++ " " ++ declaration.name.text
  }
}

fn lspHoverJson(value: Text): JsonValue = {
  val contents = Json.object()
  JsonValue.set(contents, "kind", Json.string("plaintext"))
  JsonValue.set(contents, "value", Json.string(value))
  val result = Json.object()
  JsonValue.set(result, "contents", contents)
  result
}

fn lspHandleHover(id: JsonValue, params: JsonValue, documents: LspDocuments): Unit [io] = {
  val textDocument = JsonValue.get(params, "textDocument")
  val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
  val position = JsonValue.get(params, "position")
  val requestLine = JsonValue.asInt(JsonValue.get(position, "line")) + 1
  val requestColumn = JsonValue.asInt(JsonValue.get(position, "character")) + 1
  val documentIndex = lspDocumentIndex(documents.uris, uri)
  if documentIndex >= 0 then {
    val text = List.getOrPanic(documents.texts, documentIndex)
    val requestTokens = lex(text)
    val name = lspNameTokenAt(requestTokens, requestLine, requestColumn)
    if Text.eq(name, "") then { lspRespond(id, Json.null()) }
    else {
      val declaration = lspFindDeclaration(lspDeclarationSites(requestTokens), name)
      if declaration.header != -1 then { lspRespond(id, lspHoverJson(lspDeclarationSignature(requestTokens, declaration))) }
      else {
        val crossFile = lspResolveCrossFileDeclaration(documents, lspUriToPath(uri), text, name)
        if not crossFile.found then { lspRespond(id, Json.null()) }
        else { lspRespond(id, lspHoverJson(lspDeclarationSignature(crossFile.tokens, crossFile.declaration))) }
      }
    }
  } else { lspRespond(id, Json.null()) }
}

// Every name-kind token in the file whose text matches `name` - the
// declaration site and every call site are textually identical name
// tokens, so this naturally covers both without special-casing which one
// is "the" declaration. Simpler than lspDeclarationSites: no keyword-
// adjacency check, just a text-equality filter over every name token.
fn lspOccurrences(tokens: List<Token>, name: Text): List<Token> = {
  var result: List<Token> = []
  var index = 0
  while not Text.eq(at(tokens, index).kind, "eof") {
    val current = at(tokens, index)
    if Text.eq(current.kind, "name") and Text.eq(current.text, name) then {
      result = List.push(result, current)
    }
    index = index + 1
  }
  result
}

fn lspLocationJson(uri: Text, token: Token): JsonValue = {
  val startPos = Json.object()
  JsonValue.set(startPos, "line", Json.int(token.line - 1))
  JsonValue.set(startPos, "character", Json.int(token.column - 1))
  val endPos = Json.object()
  JsonValue.set(endPos, "line", Json.int(token.line - 1))
  JsonValue.set(endPos, "character", Json.int(token.column - 1 + Text.len(token.text)))
  val range = Json.object()
  JsonValue.set(range, "start", startPos)
  JsonValue.set(range, "end", endPos)
  val location = Json.object()
  JsonValue.set(location, "uri", Json.string(uri))
  JsonValue.set(location, "range", range)
  location
}

// context.includeDeclaration isn't read - the response always includes
// every occurrence, declaration included. Respecting `false` would mean
// cross-referencing lspDeclarationSites to identify which occurrence to
// drop, for a flag most real usage doesn't set anyway - not attempted here.
fn lspHandleReferences(id: JsonValue, params: JsonValue, documents: LspDocuments): Unit [io] = {
  val textDocument = JsonValue.get(params, "textDocument")
  val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
  val position = JsonValue.get(params, "position")
  val requestLine = JsonValue.asInt(JsonValue.get(position, "line")) + 1
  val requestColumn = JsonValue.asInt(JsonValue.get(position, "character")) + 1
  val documentIndex = lspDocumentIndex(documents.uris, uri)
  if documentIndex >= 0 then {
    val text = List.getOrPanic(documents.texts, documentIndex)
    val requestTokens = lex(text)
    val name = lspNameTokenAt(requestTokens, requestLine, requestColumn)
    if Text.eq(name, "") then { lspRespond(id, Json.null()) }
    else {
      val occurrences = lspOccurrences(requestTokens, name)
      val locations = Json.array()
      for occurrence in occurrences { JsonValue.push(locations, lspLocationJson(uri, occurrence)) }
      // One level of direct `use` imports too - an occurrence inside the
      // imported file itself (e.g. an internal call) is a real occurrence,
      // not just the declaration lspResolveCrossFileDeclaration would find.
      // Same one-level scope as definition/hover; not a reverse, project-
      // wide "which files import this one" search.
      val modules = importedModules(text)
      var moduleIndex = 0
      while moduleIndex < List.len(modules) {
        val resolved = resolveModulePath(lspUriToPath(uri), List.getOrPanic(modules, moduleIndex), [])
        val importedUri = lspPathToUri(resolved.path)
        val importedText = lspReadFile(documents, importedUri, resolved.path)
        if not Text.eq(importedText, "") then {
          val importedOccurrences = lspOccurrences(lex(importedText), name)
          for importedOccurrence in importedOccurrences { JsonValue.push(locations, lspLocationJson(importedUri, importedOccurrence)) }
        }
        moduleIndex = moduleIndex + 1
      }
      lspRespond(id, locations)
    }
  } else { lspRespond(id, Json.null()) }
}

// No newName validation (empty/keyword/non-identifier) - the compiler's own
// subsequent diagnostics catch a bad rename the same way they catch any
// other invalid identifier; not duplicating that check here.
fn lspTextEditJson(occurrence: Token, newName: Text): JsonValue = {
  val startPos = Json.object()
  JsonValue.set(startPos, "line", Json.int(occurrence.line - 1))
  JsonValue.set(startPos, "character", Json.int(occurrence.column - 1))
  val endPos = Json.object()
  JsonValue.set(endPos, "line", Json.int(occurrence.line - 1))
  JsonValue.set(endPos, "character", Json.int(occurrence.column - 1 + Text.len(occurrence.text)))
  val range = Json.object()
  JsonValue.set(range, "start", startPos)
  JsonValue.set(range, "end", endPos)
  val edit = Json.object()
  JsonValue.set(edit, "range", range)
  JsonValue.set(edit, "newText", Json.string(newName))
  edit
}

fn lspHandleRename(id: JsonValue, params: JsonValue, documents: LspDocuments): Unit [io] = {
  val textDocument = JsonValue.get(params, "textDocument")
  val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
  val position = JsonValue.get(params, "position")
  val newName = JsonValue.asText(JsonValue.get(params, "newName"))
  val requestLine = JsonValue.asInt(JsonValue.get(position, "line")) + 1
  val requestColumn = JsonValue.asInt(JsonValue.get(position, "character")) + 1
  val documentIndex = lspDocumentIndex(documents.uris, uri)
  if documentIndex >= 0 then {
    val text = List.getOrPanic(documents.texts, documentIndex)
    val requestTokens = lex(text)
    val name = lspNameTokenAt(requestTokens, requestLine, requestColumn)
    if Text.eq(name, "") then { lspRespond(id, Json.null()) }
    else {
      val occurrences = lspOccurrences(requestTokens, name)
      val edits = Json.array()
      for occurrence in occurrences { JsonValue.push(edits, lspTextEditJson(occurrence, newName)) }
      val changes = Json.object()
      JsonValue.set(changes, uri, edits)

      // One level of direct `use` imports too, same scope as references
      // (an imported file's whole token stream, not just its declaration -
      // an internal use inside the import needs renaming too, not only
      // its declaration) - not a reverse, project-wide "which files import
      // this one" search.
      val modules = importedModules(text)
      var moduleIndex = 0
      while moduleIndex < List.len(modules) {
        val resolved = resolveModulePath(lspUriToPath(uri), List.getOrPanic(modules, moduleIndex), [])
        val importedUri = lspPathToUri(resolved.path)
        val importedText = lspReadFile(documents, importedUri, resolved.path)
        if not Text.eq(importedText, "") then {
          val importedOccurrences = lspOccurrences(lex(importedText), name)
          if List.len(importedOccurrences) > 0 then {
            val importedEdits = Json.array()
            for importedOccurrence in importedOccurrences { JsonValue.push(importedEdits, lspTextEditJson(importedOccurrence, newName)) }
            JsonValue.set(changes, importedUri, importedEdits)
          }
        }
        moduleIndex = moduleIndex + 1
      }

      val workspaceEdit = Json.object()
      JsonValue.set(workspaceEdit, "changes", changes)
      lspRespond(id, workspaceEdit)
    }
  } else { lspRespond(id, Json.null()) }
}

// The eof token's own line/column is "one past the last real content" -
// exactly what an end-of-file insertion needs, already computed by lex()
// for every document, no new line-counting logic required.
fn lspEofPosition(tokens: List<Token>): JsonValue = {
  var index = 0
  while not Text.eq(at(tokens, index).kind, "eof") { index = index + 1 }
  val eofToken = at(tokens, index)
  val pos = Json.object()
  JsonValue.set(pos, "line", Json.int(eofToken.line - 1))
  JsonValue.set(pos, "character", Json.int(eofToken.column - 1))
  pos
}

// The one unambiguous, deterministic quick fix to start code actions with:
// every Lume program needs a `fn main`, it's the very first error a new or
// empty script hits, and the fix is always the exact same text in the
// exact same place - no fuzzy "did you mean" matching needed, unlike most
// other E-codes. Diagnostics that don't match a known fix are simply
// skipped; the response is whatever actions were found, possibly empty,
// never an error.
fn lspMissingMainCodeAction(uri: Text, text: Text): JsonValue = {
  val insertPos = lspEofPosition(lex(text))
  // eof sitting at column 1 means the file already ends with a newline (a
  // fresh line has just begun) - insert the stub directly. Otherwise the
  // last existing line has no trailing newline yet, so one is prepended
  // first to avoid gluing the stub onto it.
  val needsLeadingNewline = JsonValue.asInt(JsonValue.get(insertPos, "character")) != 0
  val stub = (if needsLeadingNewline then newline() else "") ++ "fn main(args: [str]) -> int {" ++ newline() ++ "  return 0" ++ newline() ++ "}" ++ newline()
  val range = Json.object()
  JsonValue.set(range, "start", insertPos)
  JsonValue.set(range, "end", insertPos)
  val edit = Json.object()
  JsonValue.set(edit, "range", range)
  JsonValue.set(edit, "newText", Json.string(stub))
  val edits = Json.array()
  JsonValue.push(edits, edit)
  val changes = Json.object()
  JsonValue.set(changes, uri, edits)
  val workspaceEdit = Json.object()
  JsonValue.set(workspaceEdit, "changes", changes)
  val action = Json.object()
  JsonValue.set(action, "title", Json.string("Insert `fn main`"))
  JsonValue.set(action, "kind", Json.string("quickfix"))
  JsonValue.set(action, "edit", workspaceEdit)
  action
}

// A published diagnostic's own "message" field is already just
// "unknown function `name`" - lspPublishDiagnostics strips the "E0NNN
// line N:" prefix before it ever reaches a client, via diagnosticJson's
// own extraction. "" (this file's usual empty-sentinel) if no backtick
// pair is found, so a caller can treat that the same as "no match".
fn lspBacktickName(message: Text): Text = {
  val start = Text.indexOf(message, "`") ?? -1
  if start < 0 then ""
  else {
    val afterStart = Text.slice(message, start + 1, Text.len(message))
    val endOffset = Text.indexOf(afterStart, "`") ?? -1
    if endOffset < 0 then "" else Text.slice(afterStart, 0, endOffset)
  }
}

// Mirrors lspEofPosition's own shape, but for "just past the leading
// use-import block" instead of "end of file" - the same walk
// importedModules already uses to collect module names, tracking the
// last use statement's own line instead. {line: 0, character: 0} (top
// of file) when there is no leading use block at all.
fn lspUseInsertPosition(tokens: List<Token>): JsonValue = {
  var index = skipNewlines(tokens, 0)
  var lastUseLine = 0
  var scanning = true
  while scanning and not Text.eq(at(tokens, index).kind, "eof") {
    if Text.eq(at(tokens, index).text, "use") then {
      lastUseLine = at(tokens, index).line
      while not Text.eq(at(tokens, index).kind, "newline") and not Text.eq(at(tokens, index).kind, "eof") { index = index + 1 }
      index = skipNewlines(tokens, index)
    } else { scanning = false }
  }
  val pos = Json.object()
  JsonValue.set(pos, "line", Json.int(lastUseLine))
  JsonValue.set(pos, "character", Json.int(0))
  pos
}

fn lspAddUseImportCodeAction(uri: Text, moduleName: Text, insertPos: JsonValue): JsonValue = {
  val range = Json.object()
  JsonValue.set(range, "start", insertPos)
  JsonValue.set(range, "end", insertPos)
  val edit = Json.object()
  JsonValue.set(edit, "range", range)
  JsonValue.set(edit, "newText", Json.string("use " ++ moduleName ++ newline()))
  val edits = Json.array()
  JsonValue.push(edits, edit)
  val changes = Json.object()
  JsonValue.set(changes, uri, edits)
  val workspaceEdit = Json.object()
  JsonValue.set(workspaceEdit, "changes", changes)
  val action = Json.object()
  JsonValue.set(action, "title", Json.string("Add `use " ++ moduleName ++ "`"))
  JsonValue.set(action, "kind", Json.string("quickfix"))
  JsonValue.set(action, "edit", workspaceEdit)
  action
}

// One level (the current document's own directory, not recursive) of
// candidate sibling .lume files declaring `name` as a function - the
// same "one hop" scope this arc's cross-file resolution already uses
// for use imports themselves. A candidate already present in
// importedModules is skipped (its own name wouldn't have gone
// unresolved in the first place, but the check is cheap insurance
// against ever suggesting a duplicate `use` line). More than one match
// becomes more than one action - moduleName (a bare filename) is
// already unique per file in a directory, so no separate
// disambiguation is needed in the title.
fn lspSiblingUseCandidates(documents: LspDocuments, currentPath: Text, currentText: Text, name: Text, uri: Text, insertPos: JsonValue): List<JsonValue> = {
  var actions: List<JsonValue> = []
  val imported = importedModules(currentText)
  if let Some(entries) = listDir(Path.dirname(currentPath)) {
    for entry in entries {
      if Text.endsWith(entry, ".lume") then {
        val moduleName = Text.slice(entry, 0, Text.len(entry) - 5)
        val candidatePath = Path.join(Path.dirname(currentPath), entry)
        if not Text.eq(candidatePath, currentPath) and not containsName(imported, moduleName) then {
          val candidateUri = lspPathToUri(candidatePath)
          val candidateText = lspReadFile(documents, candidateUri, candidatePath)
          if not Text.eq(candidateText, "") then {
            val declaration = lspFindDeclaration(lspDeclarationSites(lex(candidateText)), name)
            if declaration.header != -1 and Text.eq(declaration.keyword, "fn") then {
              actions = List.push(actions, lspAddUseImportCodeAction(uri, moduleName, insertPos))
            }
          }
        }
      }
    }
  }
  actions
}

// Named lspMinInt, not minInt - a plain "minInt" collides at the
// generated-C level with an internal certo_min_int symbol Certo's own
// codegen already emits, confirmed live ("redefinition of
// 'certo_min_int'" from the C compiler) before this rename.
fn lspMinInt(a: Int, b: Int): Int = if a < b then a else b

// Classic space-optimized DP edit distance. No List.set exists in this
// codebase (only push/getOrPanic/concat), so each row is built fresh via
// List.push in a loop instead of mutated in place - the same
// accumulate-via-var-then-push idiom used everywhere else in this file
// (importedModules and friends). A cold path (runs at most a few dozen
// times per code-action request), so plain charAt-based comparison is
// fine - no need for the Bytes.byteAt hot-path rewrite lex() itself
// needed.
fn lspLevenshtein(a: Text, b: Text): Int = {
  val aLen = Text.len(a)
  val bLen = Text.len(b)
  var prevRow: List<Int> = []
  var j = 0
  while j <= bLen {
    prevRow = List.push(prevRow, j)
    j = j + 1
  }
  var i = 1
  while i <= aLen {
    var currRow: List<Int> = [i]
    val aChar = charAt(a, i - 1)
    var k = 1
    while k <= bLen {
      val cost = if Text.eq(aChar, charAt(b, k - 1)) then 0 else 1
      val deletion = List.getOrPanic(prevRow, k) + 1
      val insertion = List.getOrPanic(currRow, k - 1) + 1
      val substitution = List.getOrPanic(prevRow, k - 1) + cost
      currRow = List.push(currRow, lspMinInt(lspMinInt(deletion, insertion), substitution))
      k = k + 1
    }
    prevRow = currRow
    i = i + 1
  }
  List.getOrPanic(prevRow, bLen)
}

// A short name tolerates fewer edits before a "close" match stops
// meaning anything - the same degrading-threshold shape common typo
// tools (rustc, ESLint) use, not one flat constant for every length.
fn lspDidYouMeanThreshold(len: Int): Int = {
  if len <= 3 then 1 else if len <= 6 then 2 else 3
}

// First-match-wins on a tie (a candidate only replaces the current best
// on a strictly lower distance) - same philosophy lspFindDeclaration
// already uses for name collisions. "" (this file's usual empty
// sentinel) if nothing in `candidates` is within threshold.
fn lspClosestMatch(candidates: List<Text>, name: Text): Text = {
  val threshold = lspDidYouMeanThreshold(Text.len(name))
  var best = ""
  var bestDistance = threshold + 1
  for candidate in candidates {
    if not Text.eq(candidate, name) then {
      val distance = lspLevenshtein(candidate, name)
      if distance <= threshold and distance < bestDistance then {
        best = candidate
        bestDistance = distance
      }
    }
  }
  best
}

fn lspFunctionDeclarationNames(tokens: List<Token>): List<Text> = {
  var names: List<Text> = []
  for site in lspDeclarationSites(tokens) {
    if Text.eq(site.keyword, "fn") then { names = List.push(names, site.name.text) }
  }
  names
}

// The diagnostic's own range doesn't carry the real column -
// lspPublishDiagnostics always reports character: 0 - so the typo's
// exact token has to be relocated here. The compile pipeline only ever
// reports one error, so `line` is exact and unambiguous; scanning for
// the first name-kind token on that line matching `name` is enough,
// no need to disambiguate multiple occurrences. Defaults to column 0
// if somehow not found (defensive, matches this file's own style
// elsewhere), never panics.
fn lspTypoRange(tokens: List<Token>, line: Int, name: Text): JsonValue = {
  var index = 0
  var found = false
  var column = 1
  while not found and not Text.eq(at(tokens, index).kind, "eof") {
    val current = at(tokens, index)
    if Text.eq(current.kind, "name") and current.line == line and Text.eq(current.text, name) then {
      found = true
      column = current.column
    }
    index = index + 1
  }
  val startPos = Json.object()
  JsonValue.set(startPos, "line", Json.int(line - 1))
  JsonValue.set(startPos, "character", Json.int(column - 1))
  val endPos = Json.object()
  JsonValue.set(endPos, "line", Json.int(line - 1))
  JsonValue.set(endPos, "character", Json.int(column - 1 + Text.len(name)))
  val range = Json.object()
  JsonValue.set(range, "start", startPos)
  JsonValue.set(range, "end", endPos)
  range
}

fn lspDidYouMeanCodeAction(uri: Text, range: JsonValue, suggestion: Text): JsonValue = {
  val edit = Json.object()
  JsonValue.set(edit, "range", range)
  JsonValue.set(edit, "newText", Json.string(suggestion))
  val edits = Json.array()
  JsonValue.push(edits, edit)
  val changes = Json.object()
  JsonValue.set(changes, uri, edits)
  val workspaceEdit = Json.object()
  JsonValue.set(workspaceEdit, "changes", changes)
  val action = Json.object()
  JsonValue.set(action, "title", Json.string("Change to `" ++ suggestion ++ "`"))
  JsonValue.set(action, "kind", Json.string("quickfix"))
  JsonValue.set(action, "edit", workspaceEdit)
  action
}

fn lspHandleCodeAction(id: JsonValue, params: JsonValue, documents: LspDocuments): Unit [io] = {
  val textDocument = JsonValue.get(params, "textDocument")
  val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
  val requestContext = JsonValue.get(params, "context")
  val diagnostics = JsonValue.get(requestContext, "diagnostics")
  val actions = Json.array()
  val documentIndex = lspDocumentIndex(documents.uris, uri)
  if documentIndex >= 0 and JsonValue.isArray(diagnostics) then {
    val text = List.getOrPanic(documents.texts, documentIndex)
    val currentPath = lspUriToPath(uri)
    var index = 0
    while index < JsonValue.length(diagnostics) {
      val diagnostic = Json.parse(JsonValue.atText(diagnostics, index))
      val code = JsonValue.asText(JsonValue.get(diagnostic, "code"))
      if Text.eq(code, "E0201") then {
        JsonValue.push(actions, lspMissingMainCodeAction(uri, text))
      } else if Text.eq(code, "E0216") then {
        val name = lspBacktickName(JsonValue.asText(JsonValue.get(diagnostic, "message")))
        if not Text.eq(name, "") then {
          val tokens = lex(text)
          val insertPos = lspUseInsertPosition(tokens)
          for action in lspSiblingUseCandidates(documents, currentPath, text, name, uri, insertPos) {
            JsonValue.push(actions, action)
          }
          val candidates = List.concat(lspFunctionDeclarationNames(tokens), builtinNames())
          val suggestion = lspClosestMatch(candidates, name)
          if not Text.eq(suggestion, "") then {
            val diagStart = JsonValue.get(JsonValue.get(diagnostic, "range"), "start")
            val diagLine = JsonValue.asInt(JsonValue.get(diagStart, "line")) + 1
            val range = lspTypoRange(tokens, diagLine, name)
            JsonValue.push(actions, lspDidYouMeanCodeAction(uri, range, suggestion))
          }
        }
      }
      index = index + 1
    }
  }
  lspRespond(id, actions)
}

// LSP's SymbolKind enum - a different numbering than CompletionItemKind
// (lspDeclarationCompletionKind, above, maps that one separately).
// lspDeclarationSites only ever produces these three keywords; the
// default is defensive completeness, not a reachable case.
fn lspSymbolKind(keyword: Text): Int = {
  if Text.eq(keyword, "fn") then 12
  else if Text.eq(keyword, "type") then 23
  else if Text.eq(keyword, "enum") then 10
  else 13
}

// A name token's own span as an LSP range - shared by documentSymbol
// (range == selectionRange) and workspace/symbol (inside a Location).
fn lspTokenRange(token: Token): JsonValue = {
  val startPos = Json.object()
  JsonValue.set(startPos, "line", Json.int(token.line - 1))
  JsonValue.set(startPos, "character", Json.int(token.column - 1))
  val endPos = Json.object()
  JsonValue.set(endPos, "line", Json.int(token.line - 1))
  JsonValue.set(endPos, "character", Json.int(token.column - 1 + Text.len(token.text)))
  val range = Json.object()
  JsonValue.set(range, "start", startPos)
  JsonValue.set(range, "end", endPos)
  range
}

// Flat DocumentSymbol[] - lspDeclarationSites has no nesting/depth
// tracking at all (an impl method's own `fn` surfaces as its own entry,
// not nested under its type), the same "flat, not scope-aware"
// trade-off completion/references/rename already use. Point-range only
// (range == selectionRange, both the declaration's own name-token span)
// rather than the full body extent - no new scanning beyond what
// lspDeclarationSites already provides.
fn lspHandleDocumentSymbol(id: JsonValue, params: JsonValue, documents: LspDocuments): Unit [io] = {
  val textDocument = JsonValue.get(params, "textDocument")
  val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
  val documentIndex = lspDocumentIndex(documents.uris, uri)
  val symbols = Json.array()
  if documentIndex >= 0 then {
    val text = List.getOrPanic(documents.texts, documentIndex)
    for site in lspDeclarationSites(lex(text)) {
      val range = lspTokenRange(site.name)
      val symbol = Json.object()
      JsonValue.set(symbol, "name", Json.string(site.name.text))
      JsonValue.set(symbol, "kind", Json.int(lspSymbolKind(site.keyword)))
      JsonValue.set(symbol, "range", range)
      JsonValue.set(symbol, "selectionRange", range)
      JsonValue.push(symbols, symbol)
    }
  }
  lspRespond(id, symbols)
}

fn lspSymbolInformation(uri: Text, site: LspDeclaration): JsonValue = {
  val location = Json.object()
  JsonValue.set(location, "uri", Json.string(uri))
  JsonValue.set(location, "range", lspTokenRange(site.name))
  val symbol = Json.object()
  JsonValue.set(symbol, "name", Json.string(site.name.text))
  JsonValue.set(symbol, "kind", Json.int(lspSymbolKind(site.keyword)))
  JsonValue.set(symbol, "location", location)
  symbol
}

// Case-insensitive plain substring match, no fuzzy scoring - matches
// this arc's own "flat, simple, no ranking" philosophy everywhere else
// (completion already documents that real editors fuzzy-filter
// client-side; a search API is the one place this codebase filters
// server-side, since the spec expects it, but a plain substring check
// is enough here). An empty query matches everything, per spec.
fn lspMatchesQuery(name: Text, query: Text): Bool = {
  Text.eq(query, "") or Text.contains(Text.toLower(name), Text.toLower(query))
}

// No persistent cache - walks the workspace tree fresh on every
// request. This arc has never built caching ahead of a proven need
// (the one exception, compileOrCache's own .lbc cache, exists because
// benchmarks specifically demanded it); workspace/symbol is a rare,
// explicitly user-triggered request, not something fired on every
// keystroke the way diagnostics are, so a full walkDir per request
// never touches - and can't slow down - the single-file check path at
// all. Same fixed 32-level depth bound `lume test <dir>`'s own
// recursive discovery already uses, reused rather than inventing a new
// one. An empty workspaceRoot (client never sent one) degrades to an
// empty result rather than an error.
fn lspHandleWorkspaceSymbol(id: JsonValue, params: JsonValue, documents: LspDocuments, workspaceRoot: Text): Unit [io] = {
  val query = JsonValue.asText(JsonValue.get(params, "query"))
  val symbols = Json.array()
  if not Text.eq(workspaceRoot, "") then {
    for path in walkDir(workspaceRoot, 0, 32) {
      if Text.endsWith(path, ".lume") then {
        val uri = lspPathToUri(path)
        val text = lspReadFile(documents, uri, path)
        if not Text.eq(text, "") then {
          for site in lspDeclarationSites(lex(text)) {
            if lspMatchesQuery(site.name.text, query) then {
              JsonValue.push(symbols, lspSymbolInformation(uri, site))
            }
          }
        }
      }
    }
  }
  lspRespond(id, symbols)
}

fn lspCompletionItem(label: Text, kind: Int): JsonValue = {
  val item = Json.object()
  JsonValue.set(item, "label", Json.string(label))
  JsonValue.set(item, "kind", Json.int(kind))
  item
}

fn lspDeclarationCompletionKind(keyword: Text): Int = {
  if Text.eq(keyword, "type") then 7
  else if Text.eq(keyword, "enum") then 13
  else 3
}

// No scope resolution: every builtin plus every fn/type/enum declared
// anywhere in the currently open document, unfiltered by cursor position or
// partial-word prefix. Real editors already fuzzy-filter completion items
// against whatever's been typed client-side - this is standard LSP client
// behavior, not a workaround. Matches this arc's own established trade-off
// (flat, name-based, not scope-aware) for definition/hover/references/
// rename, applied here too rather than building real scope resolution.
fn lspHandleCompletion(id: JsonValue, params: JsonValue, documents: LspDocuments): Unit [io] = {
  val textDocument = JsonValue.get(params, "textDocument")
  val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
  val items = Json.array()
  val names = builtinNames()
  var index = 0
  while index < List.len(names) {
    JsonValue.push(items, lspCompletionItem(List.getOrPanic(names, index), 3))
    index = index + 1
  }
  val documentIndex = lspDocumentIndex(documents.uris, uri)
  if documentIndex >= 0 then {
    val text = List.getOrPanic(documents.texts, documentIndex)
    val declarations = lspDeclarationSites(lex(text))
    for declaration in declarations {
      JsonValue.push(items, lspCompletionItem(declaration.name.text, lspDeclarationCompletionKind(declaration.keyword)))
    }
  }
  lspRespond(id, items)
}

// Full-document sync only (TextDocumentSyncKind.Full = 1) - the same choice
// Certo's own LSP makes. Every didOpen/didChange carries the whole new
// text, so no state is needed to apply an edit - but textDocument/definition
// requests carry only a URI and a position, so the last-known text for each
// open URI is retained in `documents` across calls.
fn lspHandleMessage(parsed: JsonValue, documents: LspDocuments, workspaceRoot: Text): LspState = {
  val method = JsonValue.asText(JsonValue.get(parsed, "method"))
  val id = JsonValue.get(parsed, "id")
  val hasId = not JsonValue.isNull(id)
  var keepGoing = true
  var nextDocuments = documents
  var nextWorkspaceRoot = workspaceRoot
  if Text.eq(method, "initialize") then {
    val params = JsonValue.get(parsed, "params")
    val rootUriValue = JsonValue.get(params, "rootUri")
    val rootUri = if JsonValue.isNull(rootUriValue) then "" else JsonValue.asText(rootUriValue)
    // `rootUri` is deprecated but still widely sent; fall back to the
    // first workspaceFolders entry (the current-spec replacement) only
    // when it's absent or null - same array-element reparse pattern
    // loadPackageContext already uses for a JSON array of objects.
    val folders = JsonValue.get(params, "workspaceFolders")
    val fallbackUri = if Text.eq(rootUri, "") and JsonValue.isArray(folders) and JsonValue.length(folders) > 0 then {
      JsonValue.asText(JsonValue.get(Json.parse(JsonValue.atText(folders, 0)), "uri"))
    } else { "" }
    val resolvedRootUri = if not Text.eq(rootUri, "") then rootUri else fallbackUri
    if not Text.eq(resolvedRootUri, "") then { nextWorkspaceRoot = lspUriToPath(resolvedRootUri) }
    val capabilities = Json.object()
    JsonValue.set(capabilities, "textDocumentSync", Json.int(1))
    JsonValue.set(capabilities, "definitionProvider", Json.bool(true))
    JsonValue.set(capabilities, "hoverProvider", Json.bool(true))
    JsonValue.set(capabilities, "referencesProvider", Json.bool(true))
    JsonValue.set(capabilities, "renameProvider", Json.bool(true))
    JsonValue.set(capabilities, "completionProvider", Json.object())
    JsonValue.set(capabilities, "codeActionProvider", Json.bool(true))
    JsonValue.set(capabilities, "documentSymbolProvider", Json.bool(true))
    JsonValue.set(capabilities, "workspaceSymbolProvider", Json.bool(true))
    val result = Json.object()
    JsonValue.set(result, "capabilities", capabilities)
    lspRespond(id, result)
  } else if Text.eq(method, "textDocument/didOpen") then {
    val params = JsonValue.get(parsed, "params")
    val textDocument = JsonValue.get(params, "textDocument")
    val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
    val text = JsonValue.asText(JsonValue.get(textDocument, "text"))
    nextDocuments = lspDocumentsSet(documents, uri, text)
    lspCheckDocument(nextDocuments, uri, text)
  } else if Text.eq(method, "textDocument/didChange") then {
    val params = JsonValue.get(parsed, "params")
    val textDocument = JsonValue.get(params, "textDocument")
    val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
    val contentChanges = JsonValue.get(params, "contentChanges")
    val firstChange = Json.parse(JsonValue.atText(contentChanges, 0))
    val text = JsonValue.asText(JsonValue.get(firstChange, "text"))
    nextDocuments = lspDocumentsSet(documents, uri, text)
    lspCheckDocument(nextDocuments, uri, text)
  } else if Text.eq(method, "textDocument/didClose") then {
    val params = JsonValue.get(parsed, "params")
    val textDocument = JsonValue.get(params, "textDocument")
    val uri = JsonValue.asText(JsonValue.get(textDocument, "uri"))
    nextDocuments = lspDocumentsRemove(documents, uri)
    lspPublishDiagnostics(uri, "")
  } else if Text.eq(method, "textDocument/definition") then {
    lspHandleDefinition(id, JsonValue.get(parsed, "params"), documents)
  } else if Text.eq(method, "textDocument/hover") then {
    lspHandleHover(id, JsonValue.get(parsed, "params"), documents)
  } else if Text.eq(method, "textDocument/references") then {
    lspHandleReferences(id, JsonValue.get(parsed, "params"), documents)
  } else if Text.eq(method, "textDocument/rename") then {
    lspHandleRename(id, JsonValue.get(parsed, "params"), documents)
  } else if Text.eq(method, "textDocument/completion") then {
    lspHandleCompletion(id, JsonValue.get(parsed, "params"), documents)
  } else if Text.eq(method, "textDocument/codeAction") then {
    lspHandleCodeAction(id, JsonValue.get(parsed, "params"), documents)
  } else if Text.eq(method, "textDocument/documentSymbol") then {
    lspHandleDocumentSymbol(id, JsonValue.get(parsed, "params"), documents)
  } else if Text.eq(method, "workspace/symbol") then {
    lspHandleWorkspaceSymbol(id, JsonValue.get(parsed, "params"), documents, workspaceRoot)
  } else if Text.eq(method, "shutdown") then {
    lspRespond(id, Json.null())
  } else if Text.eq(method, "exit") then {
    keepGoing = false
  } else if hasId then {
    lspRespondError(id, -32601, "method not found: " ++ method)
  }
  LspState { documents: nextDocuments, running: keepGoing, workspaceRoot: nextWorkspaceRoot }
}

fn runLspServer(): Unit [io] = {
  var running = true
  var documents: LspDocuments = LspDocuments { uris: [], texts: [] }
  var workspaceRoot = ""
  while running {
    if let Some(raw) = lspReadMessage() {
      val state = lspHandleMessage(Json.parse(raw), documents, workspaceRoot)
      running = state.running
      documents = state.documents
      workspaceRoot = state.workspaceRoot
    } else { running = false }
  }
}

fn cachePath(sourcePath: Text): Text = sourcePath ++ ".lbc"

fn compileAndCache(pathToCache: Text, source: Text, hash: Text): ArtifactResult [io] = {
  val compiled = compileSource(source)
  if not Text.eq(compiled.problem, "") then { ArtifactResult { code: [], sourceHash: hash, buildHash: compilerBuildHash(), problem: compiled.problem } }
  else {
    val saveProblem = saveArtifact(pathToCache, source, compiled.code)
    ArtifactResult { code: compiled.code, sourceHash: hash, buildHash: compilerBuildHash(), problem: saveProblem }
  }
}

fn compileOrCache(path: Text, source: Text): ArtifactResult [io] = {
  val pathToCache = cachePath(path)
  val hash = Crypto.sha256(source)
  // Read only the fixed 140-byte header first (readFileBytesRange, not
  // readFileBytes) - decodeArtifact's own doc comment gives the exact
  // layout. Checking whether a hit is even possible must not itself
  // require reading a large stale artifact's full bytes into memory;
  // the full file is only read (a second, cheap file open on top of
  // the header peek) once the header confirms a hit, so a miss never
  // pays for more than 140 bytes of I/O, let alone a full instruction
  // decode.
  if let Some(headerBytes) = readFileBytesRange(pathToCache, 0, 140) {
    val header = decodeArtifactHeader(headerBytes)
    val hit = Text.eq(header.problem, "") and Text.eq(header.sourceHash, hash) and Text.eq(header.buildHash, compilerBuildHash())
    if hit then {
      if let Some(content) = readFileBytes(pathToCache) { decodeArtifact(content) }
      else { compileAndCache(pathToCache, source, hash) }
    } else { compileAndCache(pathToCache, source, hash) }
  } else { compileAndCache(pathToCache, source, hash) }
}

fn printTokens(tokens: List<Token>): Unit [io] = {
  for item in tokens {
    println(intToText(item.line) ++ ":" ++ intToText(item.column) ++ "  " ++ item.kind ++ "  " ++ item.text)
  }
}

fn printCode(code: List<Instruction>): Unit [io] = {
  var index = 0
  for item in code {
    println(intToText(index) ++ "  " ++ item.op ++ "  " ++ item.text ++ "  " ++ intToText(item.number))
    index = index + 1
  }
}

fn diagnosticJson(problem: Text, path: Text): Text = {
  val root = Json.object()
  val code = if Text.len(problem) >= 5 then Text.slice(problem, 0, 5) else "E0000"
  val lineMarker = Text.indexOf(problem, " line ") ?? -1
  var line = 0
  var message = problem
  if lineMarker >= 0 then {
    val lineStart = lineMarker + 6
    val tail = Text.slice(problem, lineStart, Text.len(problem))
    val colon = Text.indexOf(tail, ":") ?? -1
    if colon >= 0 then {
      line = parseInt(Text.slice(tail, 0, colon)) ?? 0
      message = Text.trim(Text.slice(tail, colon + 1, Text.len(tail)))
    }
  } else if Text.len(problem) > 6 then {
    message = Text.slice(problem, 6, Text.len(problem))
  }
  JsonValue.set(root, "code", Json.string(code))
  JsonValue.set(root, "severity", Json.string("error"))
  JsonValue.set(root, "file", Json.string(path))
  JsonValue.set(root, "line", Json.int(line))
  JsonValue.set(root, "message", Json.string(message))
  Json.stringify(root)
}

fn reportProblem(problem: Text, path: Text, json: Bool): Unit [io] = {
  if json then { println(diagnosticJson(problem, path)) }
  else { eprintln(problem) }
}

fn hasFlag(flag: Text): Bool = {
  var index = 3
  var found = false
  while index < argCount() and not found {
    if Text.eq(arg(index) ?? "", flag) then { found = true }
    index = index + 1
  }
  found
}

fn flagValue(flag: Text): Text? = {
  var index = 3
  var result: Text? = None
  while index < argCount() {
    if Text.eq(arg(index) ?? "", flag) then { result = arg(index + 1) }
    index = index + 1
  }
  result
}

fn testFileJson(path: Text): Text = {
  val root = Json.object()
  JsonValue.set(root, "event", Json.string("file"))
  JsonValue.set(root, "path", Json.string(path))
  Json.stringify(root)
}

fn testResultJson(id: Text, name: Text, ok: Bool, line: Int, message: Text): Text = {
  val root = Json.object()
  JsonValue.set(root, "event", Json.string("test"))
  JsonValue.set(root, "id", Json.string(id))
  JsonValue.set(root, "name", Json.string(name))
  JsonValue.set(root, "status", Json.string(if ok then "pass" else "fail"))
  JsonValue.set(root, "line", Json.int(line))
  JsonValue.set(root, "message", Json.string(message))
  Json.stringify(root)
}

fn testSummaryJson(passed: Int, failed: Int, note: Text): Text = {
  val root = Json.object()
  JsonValue.set(root, "event", Json.string("summary"))
  JsonValue.set(root, "passed", Json.int(passed))
  JsonValue.set(root, "failed", Json.int(failed))
  JsonValue.set(root, "total", Json.int(passed + failed))
  if not Text.eq(note, "") then { JsonValue.set(root, "note", Json.string(note)) }
  Json.stringify(root)
}

// Answers "what does this line look like with // comments and "..."
// string contents removed", mirroring lex's own string/comment
// recognition (see scanString and the "//" check in lex) just enough
// for formatSource's indent signal to ignore braces that appear
// inside either - a line-local scan, since formatSource itself never
// carries state across lines (no support for a string literal
// spanning physical lines, which scanString technically allows but
// no Lume source relies on).
fn stripCommentsAndStrings(line: Text): Text = {
  var output = ""
  var index = 0
  val length = Text.len(line)
  var inString = false
  while index < length {
    val ch = charAt(line, index)
    if inString then {
      if Text.eq(ch, "\\") and index + 1 < length then { index = index + 2 }
      else {
        if Text.eq(ch, "\"") then { inString = false }
        index = index + 1
      }
    } else if Text.eq(ch, "\"") then {
      inString = true
      index = index + 1
    } else if Text.eq(ch, "/") and index + 1 < length and Text.eq(charAt(line, index + 1), "/") then { index = length }
    else {
      output = output ++ ch
      index = index + 1
    }
  }
  output
}

fn formatSource(source: Text): Text = {
  val lines = Text.split(source, newline())
  var output: List<Text> = []
  var indent = 0
  var lastBlank = false
  for rawLine in lines {
    val line = Text.trim(rawLine)
    if Text.eq(line, "") then {
      if List.len(output) > 0 and not lastBlank then { output = List.push(output, "") }
      lastBlank = true
    } else {
      val signal = Text.trim(stripCommentsAndStrings(line))
      if Text.startsWith(signal, "}") then { indent = maxInt(indent - 1, 0) }
      output = List.push(output, Text.repeat("  ", indent) ++ line)
      if Text.endsWith(signal, "{") then { indent = indent + 1 }
      lastBlank = false
    }
  }
  if List.len(output) > 0 and Text.eq(List.getOrPanic(output, List.len(output) - 1), "") then {
    output = List.slice(output, 0, List.len(output) - 1)
  }
  Text.join(output, newline()) ++ newline()
}

// The single source of truth for Lume's own version string - both the
// `help` command's banner and the `api` command's JSON manifest read it
// from here, rather than each hand-maintaining its own copy of the
// literal (they used to, and could silently drift out of sync).
fn lumeVersion(): Text = "0.1.0-bootstrap"

fn apiManifest(): Text = {
  val root = Json.object()
  JsonValue.set(root, "language", Json.string("Lume"))
  JsonValue.set(root, "version", Json.string(lumeVersion()))
  val features = Json.array()
  for feature in ["bindings", "static_types", "homogeneous_lists", "generics", "generic_constraints", "protocols", "protocol_methods", "static_protocol_dispatch", "explicit_protocol_implementations", "generic_records", "generic_enums", "option", "result", "list_map", "list_filter", "list_find", "list_fold", "maps", "map_map", "map_filter", "map_fold", "function_values", "closures", "immutable_capture", "native_test_runner", "test_directory_discovery", "result_propagation", "records", "nested_records", "field_access", "record_updates", "typed_json_decoding", "json_encode", "json_encode_enums", "path_manipulation", "directory_enumeration", "time_now", "time_calendar_components", "time_format", "time_timezones", "duration_units", "process_config", "http_get", "http_post_put_delete", "http_request_headers", "bytes_type", "http_request_bytes", "test_fixtures", "enums", "variant_payloads", "match_expressions", "exhaustive_matching", "payload_destructuring", "if_else", "while", "functions", "recursion", "bytecode_cache"] {
    JsonValue.push(features, Json.string(feature))
  }
  JsonValue.set(root, "features", features)
  val functions = Json.array()
  val names = builtinNames()
  val counts = builtinCounts()
  var index = 0
  while index < List.len(names) {
    val item = Json.object()
    JsonValue.set(item, "name", Json.string(List.getOrPanic(names, index)))
    JsonValue.set(item, "arity", Json.int(List.getOrPanic(counts, index)))
    JsonValue.push(functions, item)
    index = index + 1
  }
  JsonValue.set(root, "builtins", functions)
  Json.stringify(root)
}

// Renders the same builtinNames()/builtinCounts() data apiManifest()
// already turns into JSON as human-readable Markdown instead, grouped
// into a section per namespace (the text before the first ".") as the
// already-namespace-ordered list is walked - can never drift from the
// real compiler since it's the identical source `lume api` reads, not
// a hand-maintained duplicate.
fn builtinReferenceMarkdown(): Text = {
  val names = builtinNames()
  val counts = builtinCounts()
  var output = "# Lume Builtin Reference\n\n"
  output = output ++ "Generated from `builtinNames()`/`builtinCounts()` in `src/lume.cto` (the same source `lume api` reads) by `lume api-docs` - do not hand-edit; regenerated on every build. For usage and semantics, see `docs/using-lume-the-fast-one.md`.\n\n"
  var currentNamespace = ""
  var index = 0
  while index < List.len(names) {
    val name = List.getOrPanic(names, index)
    val namespace = beforeDot(name)
    if not Text.eq(namespace, currentNamespace) then {
      if not Text.eq(currentNamespace, "") then { output = output ++ "\n" }
      output = output ++ "## " ++ namespace ++ "\n\n"
      currentNamespace = namespace
    }
    output = output ++ "- `" ++ name ++ "` - " ++ intToText(List.getOrPanic(counts, index)) ++ " argument(s)\n"
    index = index + 1
  }
  output
}

fn aiReference(): Text = {
  "Lume 0.1: fn name(arg: int) -> int { ... }. " ++
  "Bindings: let immutable, var mutable. Statements: if/else, while, return, print(expr), eprint(expr). " ++
  "Types: int, str, bool, [type], and records. Declare `type User { name: str }`, construct `User(name: \"Ada\")`, access `user.name`. " ++
  "Copy a record with checked changes using `user with { active: true }`; the original remains unchanged. " ++
  "Decode JSON with `User.from_json(text)`, which returns `result<User,str>` and reports field paths. " ++
  "Encode with `json.encode(value)`, which returns `result<str,str>`; supports int/str/bool/lists/records recursively. An enum (including Option<T>/Result<T,E>) encodes as its variant name under a \"variant\" key, with any payload fields flattened alongside it - e.g. `State.done(code: 0)` becomes `{\"variant\":\"done\",\"code\":0}`. " ++
  "Path helpers: path.join/basename/dirname/stem(text) -> str, path.extension(text) -> Option<str>. " ++
  "List a directory with dir.list(path) -> result<[str],str>; entries are names only, unsorted. " ++
  "Recursively walk a directory with dir.walk(path, maxDepth) -> result<[str],str>; unlike dir.list, entries are full paths and files only (a subdirectory is recursed into, never included in the result itself), unsorted; maxDepth 0 means no recursion (only path's own files), and an unreadable subdirectory partway through the walk is silently skipped rather than failing the whole call. lume test <dir> uses the same mechanism internally (a fixed 32-level bound, not user-configurable) to discover *_test.lume files in subdirectories, not just the given directory; --ignore name1,name2 skips recursing into any subdirectory whose own name exactly matches one in the comma-separated list (e.g. --ignore node_modules,.git), with no default ignore list. " ++
  "time.now() -> int gives the current Unix epoch seconds; time.to_iso(seconds) -> str formats it as UTC ISO-8601. " ++
  "time.year/month/day/hour/minute/second(seconds) -> int read UTC calendar components from epoch seconds. " ++
  "time.format(seconds, pattern) -> str formats epoch seconds with a strftime-style pattern (e.g. \"%Y-%m-%d\"), evaluated against UTC. " ++
  "time.in_timezone(seconds, zone) -> result<str,str> gives an ISO-8601 string with that zone's own numeric UTC offset (e.g. \"+01:00\"), and time.format_in_timezone(seconds, pattern, zone) -> result<str,str> applies a strftime-style pattern to that zone's wall-clock time (year/month/day/hour/etc. are zone- and DST-adjusted); `zone` is an IANA name like \"America/New_York\", Err for an unrecognized one; avoid %Z/%z in the pattern, which cannot reflect an arbitrary zone. " ++
  "duration.seconds/minutes/hours/days(n) -> int convert a named unit into a plain epoch-second count for readable arithmetic, e.g. `time.now() + duration.minutes(5)` instead of `time.now() + 300`. " ++
  "Duration is a distinct record type (not a plain int) for when unit-confusion bugs matter - a Duration can't be mistaken for an unrelated int at compile time the way duration.*'s plain int results can. Duration.of_seconds/of_minutes/of_hours/of_days(n: int) -> Duration construct one; Duration.add(a, b)/Duration.sub(a, b) -> Duration and Duration.scale(d, factor: int) -> Duration combine them (plain named functions, not operators - this language has no operator overloading); Duration.to_seconds(d) -> int bridges back to plain-int epoch arithmetic, e.g. `time.now() + Duration.to_seconds(Duration.of_minutes(5))`. Its `seconds` field is also readable directly (`d.seconds`), since Duration is an ordinary record. " ++
  "Run a process with stdin piped in: process.run_with_input(exe, args, input) -> process, same accessors as process.run. " ++
  "Run a process with environment overrides: process.run_with_env(exe, args, envMap: Map<str,str>) -> process; variables are restored to their prior value after the call returns. " ++
  "Run a process with a working directory and/or timeout: process.run_with_options(exe, args, workingDir: str, timeoutMs: int) -> process; workingDir \"\" means don't change directory, timeoutMs <= 0 means no timeout (block until the process exits). A timed-out process is killed and its process.code(result) is -1 - the same value a failed-to-spawn process reports, since the underlying result carries no separate timed-out flag; don't rely on -1 alone to distinguish the two. " ++
  "Make requests with http.get(url)/http.delete(url), http.post(url, body, content_type)/http.put(url, body, content_type), or http.request(method, url, headers: Map<str,str>, body) for custom headers, all -> result<http,str>; read with http.status/body/content_type/ok(response); a response is now bounded at request time (Certo stops reading once the limit is hit, not after downloading past it) - these five all use a fixed 10 MiB limit and return an error instead of the body if hit. For a caller-chosen limit, http.request_with_limit(method, url, headers, body, maxBytes) -> result<http,str> does not error on hitting the limit - it returns Ok with a truncated body, and http.truncated(response) -> bool reports whether that happened (false for every ordinary response, including the fixed-limit functions above); maxBytes <= 0 means unlimited. Windows only. " ++
  "bytes is a type distinct from str but represented identically at runtime (a deliberate scope reduction, not a NUL-safe binary type); bytes.from_str(text) -> bytes, bytes.to_str(data) -> str, bytes.length(data) -> int; content with an embedded NUL byte truncates at the NUL on round-trip. fs.read_bytes(path) -> result<bytes,str> and fs.write_bytes(path, data) -> bool mirror the str file APIs. http.request_bytes(method, url, headers, data) -> result<http,str> and http.body_bytes(response) -> bytes mirror http.request/http.body with a bytes body. " ++
  "Test fixtures: fixture.temp_dir() -> str creates a fresh unique directory (call fixture.cleanup(path) -> bool to remove it, no automatic cleanup); env.set(name, value) -> bool and env.unset(name) -> bool mutate the process environment directly. " ++
  "Declare enums with `enum State { waiting, done(code: int) }`; construct `State.waiting()` or `State.done(code: 0)`. " ++
  "Generics use `fn identity<T>(value: T) -> T`; constrain functions with Eq, Ord, Number, or Text. Option<T> and Result<T,E> are built in. " ++
  "Use list.map/filter/find/fold with `&double` or immutable-capture closures; use `?` to propagate Result errors. " ++
  "Map<K,V> via map.new/len/get/set/has/remove/keys/values; map.get returns Option<V>; keys must be int, str, or bool. " ++
  "Transform maps with map.map/filter/fold, same callback convention as list.*, operating on values only (keys pass through unchanged). " ++
  "Match every variant with `match state { waiting => \"wait\", done(code) => \"done\" }`; payload bindings are typed and arm-local. " ++
  "Record construction requires every field exactly once and is statically checked. Operators: + - * / % == != < <= > >=, plus the boolean keyword-operators and/or/not (short-circuiting: and/or's right operand is only evaluated when the left doesn't already determine the result; not binds tighter than and, which binds tighter than or; both operands of and/or and not's own operand must be bool). " ++
  "Builtins and arities are returned by `lume api`. main signature: fn main(args: [str]) -> int. " ++
  "Use two-space indentation, braces, one statement per line, and no semicolons. " ++
  "lume lsp runs a persistent Language Server Protocol server over stdio (Content-Length-framed JSON-RPC, full-document sync), backed by the real compiler's own declaration data: diagnostics (one level of `use`-import resolution, so a multi-file project doesn't show spurious errors), go-to-definition, hover, find-references, rename, document/workspace symbols, completion, and quickfix code actions (insert a missing `fn main`, add a missing `use` import, \"did you mean\" for a misspelled name). The one limitation: compileSource, like every Lume compile path, reports only the first diagnostic per file."
}

fn usage(): Unit [io] = {
  println("lume " ++ lumeVersion())
  println("usage: lume run <file.lume> [args...]")
  println("       lume check|tokens|bytecode <file.lume>")
  println("       lume build <file.lume> [output.lbc]")
  println("       lume exec <file.lbc>")
  println("       lume benchmark <file.lume> [iterations]")
  println("       lume profile <file.lume> [iterations]")
  println("       lume test <file.lume|dir> [--filter text] [--ignore names]")
  println("       lume fmt <file.lume> [--check]")
  println("       lume install <dir> [--check]")
  println("       lume lsp")
  println("       lume api|api-docs|ai-reference")
}

fn runCode(code: List<Instruction>): Unit [io] = {
  val outcome = execute(code)
  if Text.eq(outcome.problem, "") then { Process.quit(outcome.code) }
  else {
    eprintln(outcome.problem)
    Process.quit(1)
  }
}

fn printTestResult(json: Bool, id: Text, name: Text, ok: Bool, line: Int, message: Text): Unit [io] = {
  if json then { println(testResultJson(id, name, ok, line, message)) }
  else if ok then { println("PASS " ++ name) }
  else { println("FAIL " ++ name ++ " (line " ++ intToText(line) ++ "): " ++ message) }
}

fn runTests(code: List<Instruction>, filter: Text, json: Bool, path: Text): Unit [io] = {
  var passed = 0
  var failed = 0
  var discovered = 0
  for item in code {
    val name = beforePipe(item.text)
    val declaredTest = not Text.eq(markerTestName(item.text), "")
    val displayName = if declaredTest then markerTestName(item.text) else name
    val id = path ++ "#" ++ displayName
    if Text.eq(item.op, "function") and (declaredTest or Text.startsWith(name, "test_")) and (Text.eq(filter, "") or Text.contains(id, filter)) then {
      discovered = discovered + 1
      if item.number != 0 or not Text.eq(markerReturnType(item.text), "bool") then {
        printTestResult(json, id, displayName, false, item.line, "tests must take no parameters and return bool")
        failed = failed + 1
      } else {
        val declaredTimeoutMs = markerTestTimeout(item.text)
        val deadlineMs = if declaredTimeoutMs > 0 then monotonicMillis() + declaredTimeoutMs else 0
        val outcome = callPure(code, "f:" ++ name, [], deadlineMs, declaredTimeoutMs)
        if not Text.eq(outcome.problem, "") then {
          printTestResult(json, id, displayName, false, item.line, outcome.problem)
          failed = failed + 1
        } else if Text.eq(valueKind(outcome.value), "b:") and Text.eq(valueBody(outcome.value), "true") then {
          printTestResult(json, id, displayName, true, item.line, "")
          passed = passed + 1
        } else {
          val detail = if Text.eq(valueKind(outcome.value), "x:") then valueBody(outcome.value) else "returned false"
          printTestResult(json, id, displayName, false, item.line, detail)
          failed = failed + 1
        }
      }
    }
  }
  if discovered == 0 then {
    val note = if Text.eq(filter, "") then "no tests found" else "no tests matched `" ++ filter ++ "`"
    if json then { println(testSummaryJson(0, 0, note)) } else { println("FAIL " ++ note) }
    Process.quit(1)
  } else {
    if json then { println(testSummaryJson(passed, failed, "")) }
    else { println(intToText(passed) ++ " passed; " ++ intToText(failed) ++ " failed") }
    if failed > 0 then { Process.quit(1) }
  }
}

fn main(): Unit [io] = {
  val command = arg(1) ?? "help"
  val path = arg(2) ?? ""
  val jsonDiagnostics = Text.eq(arg(3) ?? "", "--json")
  val testJson = hasFlag("--json")
  if Text.eq(command, "api") then {
    println(apiManifest())
  } else if Text.eq(command, "api-docs") then {
    println(builtinReferenceMarkdown())
  } else if Text.eq(command, "ai-reference") then {
    println(aiReference())
  } else if Text.eq(command, "lsp") then {
    runLspServer()
  } else if Text.eq(command, "help") or Text.eq(command, "--help") or Text.eq(path, "") then {
    usage()
  } else if Text.eq(command, "exec") then {
    val artifact = loadArtifact(path)
    if not Text.eq(artifact.problem, "") then {
      eprintln(artifact.problem)
      Process.quit(1)
    } else { runCode(artifact.code) }
  } else if Text.eq(command, "install") then {
    installPackages(path, hasFlag("--check"))
  } else if let Some(entries) = listDir(path) {
    if not Text.eq(command, "test") then {
      eprintln("command `" ++ command ++ "` requires a file")
      Process.quit(1)
    } else {
      val filter = flagValue("--filter") ?? ""
      val rawIgnore = flagValue("--ignore") ?? ""
      var ignoreNames: List<Text> = []
      if not Text.eq(rawIgnore, "") then {
        for name in Text.split(rawIgnore, ",") { ignoreNames = List.push(ignoreNames, Text.trim(name)) }
      }
      var files = 0
      // 32 levels is a fixed, generous internal bound - not a --max-depth
      // CLI flag, since none was requested; deep enough for any real
      // project layout while still bounding a pathological/looping tree.
      for testPath in walkDirIgnoring(path, 0, 32, ignoreNames) {
        if Text.endsWith(testPath, "_test.lume") then {
          files = files + 1
          if testJson then { println(testFileJson(testPath)) } else { println("TEST " ++ testPath) }
          val program = loadProgram(testPath)
          if not Text.eq(program.problem, "") then {
            reportProblem(program.problem, testPath, testJson)
            Process.quit(1)
          }
          val compiled = compileSource(program.source)
          if not Text.eq(compiled.problem, "") then {
            reportProblem(compiled.problem, testPath, testJson)
            Process.quit(1)
          }
          runTests(compiled.code, filter, testJson, testPath)
        }
      }
      if files == 0 then {
        reportProblem("E0503 no *_test.lume files found in `" ++ path ++ "`", path, testJson)
        Process.quit(1)
      }
    }
  } else if let Some(source) = readFile(path) {
    val rootTokens = lex(source)
    if Text.eq(command, "tokens") then {
      printTokens(rootTokens)
    } else if Text.eq(command, "fmt") then {
      val formatted = formatSource(source)
      if Text.eq(arg(3) ?? "", "--check") then {
        if Text.eq(source, formatted) then { println("ok") }
        else {
          reportProblem("E0501 file is not canonically formatted", path, jsonDiagnostics)
          Process.quit(1)
        }
      } else if writeFile(path, formatted) then { println("formatted " ++ path) }
      else {
        reportProblem("E0502 cannot write formatted file", path, jsonDiagnostics)
        Process.quit(1)
      }
    } else {
      val program = loadProgram(path)
      if not Text.eq(program.problem, "") then {
        reportProblem(program.problem, path, jsonDiagnostics)
        Process.quit(1)
      }
      val combinedSource = program.source
      val compiled = compileSource(combinedSource)
      if not Text.eq(compiled.problem, "") then {
        reportProblem(compiled.problem, path, jsonDiagnostics)
        Process.quit(1)
      } else if Text.eq(command, "check") then {
        println("ok")
      } else if Text.eq(command, "test") then {
        val filter = flagValue("--filter") ?? ""
        runTests(compiled.code, filter, testJson, path)
      } else if Text.eq(command, "bytecode") then {
        printCode(compiled.code)
      } else if Text.eq(command, "run") then {
        val artifact = compileOrCache(path, combinedSource)
        if not Text.eq(artifact.problem, "") then {
          eprintln(artifact.problem)
          Process.quit(1)
        } else { runCode(artifact.code) }
      } else if Text.eq(command, "build") then {
        val output = arg(3) ?? cachePath(path)
        val saveProblem = saveArtifact(output, combinedSource, compiled.code)
        if not Text.eq(saveProblem, "") then {
          eprintln(saveProblem)
          Process.quit(1)
        }
        else { println("wrote " ++ output) }
      } else if Text.eq(command, "benchmark") then {
        val iterations = parseInt(arg(3) ?? "1000") ?? 1000
        val startCompile = monotonicMillis()
        var index = 0
        var instructionCount = 0
        while index < iterations {
          val measured = compileSource(combinedSource)
          instructionCount = List.len(measured.code)
          index = index + 1
        }
        val compileMs = monotonicMillis() - startCompile
        val encoded = encodeArtifact(combinedSource, compiled.code)
        val startLoad = monotonicMillis()
        index = 0
        while index < iterations {
          val decoded = decodeArtifact(encoded)
          instructionCount = List.len(decoded.code)
          index = index + 1
        }
        val loadMs = monotonicMillis() - startLoad
        println("iterations=" ++ intToText(iterations))
        println("instructions=" ++ intToText(instructionCount))
        println("compile_total_ms=" ++ intToText(compileMs))
        println("bytecode_load_total_ms=" ++ intToText(loadMs))
      } else if Text.eq(command, "profile") then {
        // A 3-bucket phase breakdown, not 5: lex() and
        // scanRecords/scanEnums/scanFunctions (the declaration scan) are
        // separately callable pure functions, so those two are timed
        // precisely. compile() itself fuses per-function codegen (the
        // emitter), protocol-impl validation, verifyTypes (the verifier),
        // and patchGenericDispatch with no seam between them - splitting
        // those three out would mean either changing CompileResult/
        // compile()'s signature (used by every command) or duplicating its
        // ~140-line body purely for instrumentation, so they stay one
        // combined bucket. compile() also always re-derives declarations
        // from tokens itself (no way to hand it pre-scanned ones without
        // that same signature change), so compile_total_ms unavoidably
        // re-includes a full scan pass - the last line is explicitly an
        // estimate (a subtraction against the separately-measured
        // scan_total_ms), not a fourth precisely-isolated bucket.
        val iterations = parseInt(arg(3) ?? "1000") ?? 1000
        val tokens = lex(combinedSource)

        val startLex = monotonicMillis()
        var lexIndex = 0
        while lexIndex < iterations {
          val discardTokens = lex(combinedSource)
          lexIndex = lexIndex + 1
        }
        val lexMs = monotonicMillis() - startLex

        val startScan = monotonicMillis()
        var scanIndex = 0
        while scanIndex < iterations {
          val discardRecords = scanRecords(tokens)
          val discardEnums = scanEnums(tokens)
          val discardFunctions = scanFunctions(tokens)
          scanIndex = scanIndex + 1
        }
        val scanMs = monotonicMillis() - startScan

        val startProfileCompile = monotonicMillis()
        var compileIndex = 0
        var profileInstructionCount = 0
        while compileIndex < iterations {
          val measured = compile(tokens)
          profileInstructionCount = List.len(measured.code)
          compileIndex = compileIndex + 1
        }
        val profileCompileMs = monotonicMillis() - startProfileCompile

        println("iterations=" ++ intToText(iterations))
        println("instructions=" ++ intToText(profileInstructionCount))
        println("lex_total_ms=" ++ intToText(lexMs))
        println("scan_total_ms=" ++ intToText(scanMs))
        println("compile_total_ms=" ++ intToText(profileCompileMs))
        println("estimated_codegen_verify_patch_total_ms=" ++ intToText(maxInt(profileCompileMs - scanMs, 0)))
      } else {
        eprintln("unknown command: " ++ command)
        usage()
        Process.quit(64)
      }
    }
  } else {
    eprintln("cannot read file: " ++ path)
    Process.quit(1)
  }
}

test "lexer recognizes a binding" {
  val tokens = lex("let answer = 42" ++ newline())
  assert(Text.eq(List.getOrPanic(tokens, 0).text, "let"), "expected let")
  assert(Text.eq(List.getOrPanic(tokens, 1).text, "answer"), "expected name")
  assert(Text.eq(List.getOrPanic(tokens, 3).text, "42"), "expected number")
}

test "compiler emits arithmetic bytecode" {
  val source = "fn main(args: [str]) -> int {" ++ newline() ++
    "return 2 + 3 * 4" ++ newline() ++ "}" ++ newline()
  val result = compile(lex(source))
  assert(Text.eq(result.problem, ""), result.problem)
  assert(List.len(result.code) == 7, "expected seven instructions")
}
